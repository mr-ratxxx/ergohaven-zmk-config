#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// Константы для перемещений

#define BASE_LAYER 0
#define BASE_ADD_LAYER 1
#define BASE_MIRROR_LAYER 2
#define NAV_R_LAYER 3
#define NAV_L_LAYER 4
#define NAV_MOUSE_R_LAYER 5
#define NAV_MOUSE_L_LAYER 6
#define FUNCT_LAYER 7
#define NUM_LAYER 8
#define SYMB_LAYER 9
#define LAYERS_LAYER 10
#define ADJ_LAYER 11
#define BASE_OVERRIDE_LAYER 12
#define BASE_ADD_OVERRIDE_LAYER 13

#define MMV_SLOW_ALT_SPEED 250
#define MMV_SLOW_ALT_SPEED_L -250
#define MMV_SLOW_ALT_SPEED_U -250
#define MMV_SLOW_ALT_SPEED_D 250
#define MMV_SLOW_ALT_SPEED_R 250

//

#define MMV_FAST_ALT_SPEED_X 950
#define MMV_FAST_ALT_SPEED_Y 950
#define MMV_FAST_ALT_SPEED_L -950
#define MMV_FAST_ALT_SPEED_U -950
#define MMV_FAST_ALT_SPEED_D 950
#define MMV_FAST_ALT_SPEED_R 950

//

#define MMV_FAST_SPEED_X 700
#define MMV_FAST_SPEED_Y 480
#define MMV_FAST_SPEED_L -MMV_FAST_SPEED_X
#define MMV_FAST_SPEED_U -MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_D MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_R MMV_FAST_SPEED_X

//
// 1100x750, 700x480, 600x410
#define MMV_SUPER_FAST_SPEED_X 1100
#define MMV_SUPER_FAST_SPEED_Y 750
#define MMV_SUPER_FAST_SPEED_L -MMV_SUPER_FAST_SPEED_X
#define MMV_SUPER_FAST_SPEED_U -MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_D MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_R MMV_SUPER_FAST_SPEED_X

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
  tapping-term-ms = <180>;
  flavor = "balanced";
  quick-tap-ms = <50>;
};

&msc {
  time-to-max-speed-ms = <8>;
  acceleration-exponent = <5>;
};

&mmv {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <100>;
  delay-ms = <0>;
};

&lt {
  tapping-term-ms = <171>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
    };

   combos {
        compatible = "zmk,combos";
        
        BACK_L {
            bindings = <&kp RG(LEFT_BRACKET)>;
            key-positions = <11 12>;
            layers = <FUNCT_LAYER NAV_L_LAYER NAV_R_LAYER NAV_MOUSE_L_LAYER NAV_MOUSE_R_LAYER>;
        };

        FORWARD_L {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <10 11>;
            layers = <FUNCT_LAYER NAV_L_LAYER NAV_R_LAYER NAV_MOUSE_L_LAYER NAV_MOUSE_R_LAYER>;
        };
        
         BACK_R {
            bindings = <&kp RG(LEFT_BRACKET)>;
            key-positions = <15 16>;
            layers = <FUNCT_LAYER>;
         };
        
         FORWARD_R {
             bindings = <&kp RG(RIGHT_BRACKET)>;
             key-positions = <16 17>;
             layers = <FUNCT_LAYER>;
         };

        PG_DOWN_L {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <2 12>;
        };

        PG_DOWN_R {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <8 18>;
        };

        CMD_PG_UP_L {
            bindings = <&kp PAGE_UP>;
            key-positions = <3 13>;
        };

        CMD_PG_UP_R {
            bindings = <&kp PAGE_UP>;
            key-positions = <7 17>;
        };

        M_DOWN_L {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <12 22>;
        };

        M_DOWN_R {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <8 18>;
        };

        M_UP_L {
            bindings = <&msc SCRL_UP>;
            key-positions = <13 23>;
        };

        M_UP_R {
            bindings = <&msc SCRL_UP>;
            key-positions = <17 27>;
        };

        M_LEFT_L {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <18 28>;
        };

        M_LEFT_R {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <11 21>;
        };

        M_RIGHT_L {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <11 21>;
        };

        M_RIGHT_R {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <19 29>;
        };

        CMD_TAB_L {
            bindings = <&kp LG(TAB)>;
            key-positions = <14 15>;
        };

        CMD_TAB_R {
            bindings = <&kp LG(TAB)>;
            key-positions = <21 22>;
        };

        CAPS_L {
            bindings = <&kp CAPS>;
            key-positions = <40 41>;
        };       

        FROM_LAYERS_TO_ADJ_LAYER {
            bindings = <&tog ADJ_LAYER>;
            key-positions = <10 11>;
            layers = <FUNCT_LAYER LAYERS_LAYER ADJ_LAYER>;
        };

        ENTER_R {
            bindings = <&kp ENTER>;
            key-positions = <46 47>;
        };

        ENTER_L {
            bindings = <&kp ENTER>;
            key-positions = <38 39>;
        };

        N0_L {
            bindings = <&kp N0>;
            key-positions = <27 28>;
            layers = <NUM_LAYER>;
        };

        N0_R {
            bindings = <&kp N0>;
            key-positions = <31 32>;
            layers = <NUM_LAYER>;
        };

        N0_L1 {
            bindings = <&kp N0>;
            key-positions = <39 40>;
            layers = <NUM_LAYER>;
        };

        N0_R2 {
            bindings = <&kp N0>;
            key-positions = <45 46>;
            layers = <NUM_LAYER>;
        };
        
        MOUSE1_ML_L {
                    bindings = <&mkp MB1>;
                    key-positions = <28 27>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };
        
                MOUSE2_ML_L {
                    bindings = <&mkp MB2>;
                    key-positions = <28 27 26>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };
        
                MOUSE1_ML_R {
                    bindings = <&mkp MB1>;
                    key-positions = <31 32>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };
        
                MOUSE2_ML_R {
                    bindings = <&mkp MB2>;
                    key-positions = <31 32 33>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };


        MOUSE1_R {
            bindings = <&mkp MB1>;
            key-positions = <45 46>;
        };

        MOUSE2_R {
            bindings = <&mkp MB2>;
            key-positions = <45 46 47>;
        };

        MOUSE1_L {
            bindings = <&mkp MB1>;
            key-positions = <40 39>;
        };

        MOUSE2_L {
            bindings = <&mkp MB2>;
            key-positions = <38 39 40>;
        };

        MOUSE1_UP_R {
            bindings = <&mkp MB1>;
            key-positions = <19 20>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_UP_R {
            bindings = <&mkp MB2>;
            key-positions = <21 20 19>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE1_UP_L {
            bindings = <&mkp MB1>;
            key-positions = <16 15>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_UP_L {
            bindings = <&mkp MB2>;
            key-positions = <14 15 16>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        UI_REVERT {
            bindings = <&kp RG(Z)>;
            key-positions = <20 19>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UIO_REPEAT {
            bindings = <&kp LS(LG(Z))>;
            key-positions = <20 21>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UI_REVERT_L {
            bindings = <&kp RG(Z)>;
            key-positions = <15 16>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UIO_REPEAT_L {
            bindings = <&kp LS(LG(Z))>;
            key-positions = <14 15>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        CAPS_WORLD {
            bindings = <&my_caps_word>;
            key-positions = <27 28 31 32>;
            layers = <BASE_LAYER BASE_ADD_LAYER BASE_MIRROR_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
        };
        
        TO_BASE_L {
                    bindings = <&to BASE_LAYER>;
                    key-positions = <16 28 29 17>;
                };
        
                TO_BASE_R {
                    bindings = <&to BASE_LAYER>;
                    key-positions = <18 19 31 30>;
                };
                
        BT_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 4>;
            layers = <FUNCT_LAYER>;
        };

        BT_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <4 3>;
            layers = <FUNCT_LAYER>;
        };

        BT_2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <3 2>;
            layers = <FUNCT_LAYER>;
        };

        BT_3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <2 1>;
            layers = <FUNCT_LAYER>;
        };

        BT_4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <1 0>;
            layers = <FUNCT_LAYER>;
        };

        BT_CLEAR {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 1 2 3>;
            layers = <FUNCT_LAYER>;
        };
         
         QUESTION_RUEN {
                           bindings = <&kp RS(SLASH)>;
                           key-positions = <47 48>;
                           layers = <BASE_LAYER BASE_ADD_LAYER>;
                        };
                        
                        QUESTION_RUEN2 {
                                                   bindings = <&kp RS(SLASH)>;
                                                   key-positions = <33 34>;
                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                };
                                                
    SLASH_HIGH {
                                                       bindings = <&kp SLASH>;
                                                       key-positions = <30 31>;
                                                       layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                    };                                  
                                                    SLASH_DOWN {
                                                                                                                                                   bindings = <&kp BSLH>;
                                                                                                                                                   key-positions = <44 45>;
                                                                                                                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                                                                                                                };
                                                  
                        UI_RU {
                                                   bindings = <&kp LBKT>;
                                                   key-positions = <19 20>;
                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                };
                        
                        IO_RU {
                                                   bindings = <&kp RBKT>;
                                                   key-positions = <20 21>;
                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                };                      
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R          &kp T                          &kp Y  &kp U         &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F   &kp G                          &kp H  &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V          &kp B                          &kp N  &kp M         &kp COMMA     &kp DOT      &kp SQT
                                          &kp BACKSPACE  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp TAB
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp N1         &kp N2    &kp N3     &kp N4     &kp N5                        &kp N6           &kp N7           &kp N8           &kp N9        &kp N0
  &hml LGUI ESC  &kp LALT  &kp LSHFT  &kp LCTRL  &kp ENTER                     &kp PRINTSCREEN  &hmr RCTRL LEFT  &hmr RSHFT DOWN  &hmr LALT UP  &hmr RGUI RIGHT
  &none          &kp HOME  &kp INS    &kp END    &kp DELETE                    &kp CAPS         &none            &kp PG_DN        &kp PG_UP     &none
                                      &trans     &trans      &trans    &trans  &mo 3            &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
  &none           &kp LT          &kp EQUAL         &kp GT           &kp GRAVE                    &kp CARET  &kp LBKT         &kp UNDER        &kp RBKT        &none
  &hml LGUI BSLH  &hml LALT LPAR  &hml LSHFT MINUS  &hml LCTRL RPAR  &kp PLUS                     &kp PRCNT  &hmr RCTRL LBRC  &hmr RSHFT SEMI  &hmr LALT RBRC  &hmr RGUI EXCL
  &kp HASH        &kp STAR        &kp COLON         &kp FSLH         &none                        &none      &kp PIPE         &kp TILDE        &kp AMPS        &kp DLLR
                                                    &trans           &mo 3      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_CLR
  &kp LGUI     &hml LALT F5  &hml LSHFT F6  &hml LCTRL F7  &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9        &kp F10        &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                            &trans         &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
