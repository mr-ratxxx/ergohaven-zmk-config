#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// Константы для перемещений

#define BASE_LAYER 0
#define BASE_ADD_LAYER 1
#define BASE_MIRROR_LAYER 2
#define NAV_R_LAYER 3
#define NAV_L_LAYER 4
#define NAV_MOUSE_R_LAYER 5
#define NAV_MOUSE_L_LAYER 6
#define FUNCT_LAYER 7
#define NUM_LAYER 8
#define SYMB_LAYER 9
#define LAYERS_LAYER 10
#define ADJ_LAYER 11
#define BASE_OVERRIDE_LAYER 12
#define BASE_ADD_OVERRIDE_LAYER 13

#define MMV_SLOW_ALT_SPEED 250
#define MMV_SLOW_ALT_SPEED_L -250
#define MMV_SLOW_ALT_SPEED_U -250
#define MMV_SLOW_ALT_SPEED_D 250
#define MMV_SLOW_ALT_SPEED_R 250

//

#define MMV_FAST_ALT_SPEED_X 950
#define MMV_FAST_ALT_SPEED_Y 950
#define MMV_FAST_ALT_SPEED_L -950
#define MMV_FAST_ALT_SPEED_U -950
#define MMV_FAST_ALT_SPEED_D 950
#define MMV_FAST_ALT_SPEED_R 950

//

#define MMV_FAST_SPEED_X 700
#define MMV_FAST_SPEED_Y 480
#define MMV_FAST_SPEED_L -MMV_FAST_SPEED_X
#define MMV_FAST_SPEED_U -MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_D MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_R MMV_FAST_SPEED_X

//
// 1100x750, 700x480, 600x410
#define MMV_SUPER_FAST_SPEED_X 1100
#define MMV_SUPER_FAST_SPEED_Y 750
#define MMV_SUPER_FAST_SPEED_L -MMV_SUPER_FAST_SPEED_X
#define MMV_SUPER_FAST_SPEED_U -MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_D MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_R MMV_SUPER_FAST_SPEED_X

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
  tapping-term-ms = <180>;
  flavor = "balanced";
  quick-tap-ms = <50>;
};

&msc {
  time-to-max-speed-ms = <8>;
  acceleration-exponent = <5>;
};

&mmv {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <100>;
  delay-ms = <0>;
};

&lt {
  tapping-term-ms = <171>;
};

/ {
  behaviors {
     my_caps_word: my_caps_word {
        compatible = "zmk,behavior-caps-word";
        label = "MY_CAPS_WORD";
        #binding-cells = <0>;
        continue-list = <UNDERSCORE MINUS COMMA PERIOD SEMICOLON SPACE>;
     };
            
    enc_vol: enc_vol {
      compatible = "zmk,behavior-sensor-rotate";
      label = "ENC_VOL";
      #sensor-binding-cells = <0>;
      bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
    };
        
    // ru-б en/alt-ru ,
    alt_ru_en_comma: alt_ru_en_comma {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_COMMA";
      #binding-cells = <0>;
      bindings = <&kp COMMA>, <&kp RS(N6)>;
      mods = <(MOD_LALT | MOD_RALT)>;
      keep-mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    // ru-ж en/alt-ru
    alt_ru_en_semi: alt_ru_en_semi {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_SEMI";
      #binding-cells = <0>;
      bindings = <&mt RGUI SEMI>, <&kp RS(N8)>;
      mods = <(MOD_LALT | MOD_RALT)>;
      keep-mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    // ru-э en/alt-ru "
    alt_ru_en_sqt: alt_ru_en_sqt {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_SQT";
      #binding-cells = <0>;
      bindings = <&kp SQT>, <&kp RS(N2)>;
      mods = <(MOD_LALT | MOD_RALT)>;
      keep-mods = <(MOD_LCTL | MOD_RCTL)>;
    };                       

    ctrl_left_bracket: ctrl_left_bracket {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_LEFT_BRACKET";
      #binding-cells = <0>;
      bindings = <&kp COMMA>, <&kp LEFT_BRACKET>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
      keep-mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    ctrl_right_bracket: ctrl_right_bracket {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_RIGHT_BRACKET";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp RIGHT_BRACKET>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
      keep-mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    ctrl_p_sqt: ctrl_p_sqt {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_P_SQT";
      #binding-cells = <0>;
      bindings = <&kp P>, <&kp SQT>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
      keep-mods = <(MOD_LCTL | MOD_RCTL)>;
    };
    
    ralt_y_up3: ralt_y_up3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_Y_UP3";
      #binding-cells = <0>;
      bindings = 
        <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
      mods = <(MOD_RALT)>;
    };

    ralt_y_down3: ralt_y_down3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_Y_DOWN3";
      #binding-cells = <0>;
      bindings = 
        <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
      mods = <(MOD_RALT)>;
    };

    ralt_x_left3: ralt_x_left3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_X_LEFT3";
      #binding-cells = <0>;
      bindings =
        <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
      mods = <(MOD_RALT)>;
    };

    ralt_x_right3: ralt_x_right3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_X_RIGHT3";
      #binding-cells = <0>;
      bindings =
        <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
      mods = <(MOD_RALT)>;
    };
    
    /* */
    ralt_y_up_f: ralt_y_up_f {
          compatible = "zmk,behavior-mod-morph";
          label = "ralt_y_up_f";
          #binding-cells = <0>;
          bindings = 
            <&kp UP_ARROW>,
            <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
          mods = <(MOD_RALT)>;
        };
    
        ralt_y_down_f: ralt_y_down_f {
          compatible = "zmk,behavior-mod-morph";
          label = "ralt_y_down_f";
          #binding-cells = <0>;
          bindings = 
            <&kp DOWN>,
            <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
          mods = <(MOD_RALT)>;
        };
    
        ralt_x_left_f: ralt_x_left_f {
          compatible = "zmk,behavior-mod-morph";
          label = "ralt_x_left_f";
          #binding-cells = <0>;
          bindings =
            <&kp LEFT>,
            <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
          mods = <(MOD_RALT)>;
        };
    
        ralt_x_right_f: ralt_x_right_f {
          compatible = "zmk,behavior-mod-morph";
          label = "ralt_x_right_f";
          #binding-cells = <0>;
          bindings =
            <&kp RIGHT>,
            <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
          mods = <(MOD_RALT)>;
        };
    /* */

    /* mouse 0 layer */
    ralt_base_left: ralt_base_left {
      compatible = "zmk,behavior-mod-morph";
      label = "ralt_base_left";
      #binding-cells = <0>;
      bindings =
        <&kp M>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
      mods = <(MOD_RALT)>;
    };

    ralt_base_up: ralt_base_up {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_BASE_UP";
      #binding-cells = <0>;
      bindings = 
        <&kp COMMA>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
      mods = <(MOD_RALT)>;
    };

    ralt_base_down: ralt_base_down {
      compatible = "zmk,behavior-mod-morph";
      label = "ralt_base_down";
      #binding-cells = <0>;
      bindings = 
        <&kp DOT>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
      mods = <(MOD_RALT)>;
    };

    ralt_base_right: ralt_base_right {
      compatible = "zmk,behavior-mod-morph";
      label = "ralt_base_right";
      #binding-cells = <0>;
      bindings =
        <&kp SLASH>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
      mods = <(MOD_RALT)>;
    };
    /* end mouse 0 layer */

    layer_lt_tap: layer_lt_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "LAYER_LT_TAP";
      #binding-cells = <2>;
      tapping-term-ms = <180>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&lt>, <&kp>;
    };

    layer_hold_tap: layer_hold_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "LAYER_HOLD_TAP";
      #binding-cells = <2>;
      tapping-term-ms = <180>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&tog>, <&kp>;
    };

    layer_to_tap: layer_to_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "LAYER_TO_TAP";
      #binding-cells = <2>;
      tapping-term-ms = <180>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&to>, <&kp>;
    };
  };

    combos {
        compatible = "zmk,combos";
        
         ESC_COMBO {
                    bindings = <&kp ESC>;
                    key-positions = <13 14>;
                    layers = <BASE_LAYER BASE_ADD_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
                };
                
                  RU_E {
                                    bindings = <&kp T>;
                                    key-positions = <16 17>;
                                    layers = <BASE_LAYER BASE_ADD_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
                                };
        
        BACK_L {
            bindings = <&kp RG(LEFT_BRACKET)>;
            key-positions = <27 28>;
            layers = <FUNCT_LAYER>;
        };
        
        FORWARD_L {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <26 27>;
            layers = <FUNCT_LAYER>;
        };
        
        BACK_R {
            bindings = <&kp RG(LEFT_BRACKET)>;
            key-positions = <31 32>;
            layers = <FUNCT_LAYER>;
        };
                        
        FORWARD_R {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <32 33>;
            layers = <FUNCT_LAYER>;
        };

        PG_DOWN_L {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <26 14>;
        };

        PG_DOWN_R {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <33 21>;
        };

        CMD_PG_UP_L {
            bindings = <&kp PAGE_UP>;
            key-positions = <27 15>;
        };

        CMD_PG_UP_R {
            bindings = <&kp PAGE_UP>;
            key-positions = <32 20>;
        };

        M_DOWN_L {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <26 38>;
        };

        M_DOWN_R {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <33 47>;
        };

        M_UP_L {
            bindings = <&msc SCRL_UP>;
            key-positions = <27 39>;
        };

        M_UP_R {
            bindings = <&msc SCRL_UP>;
            key-positions = <32 46>;
        };

        M_LEFT_L {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <28 40>;
        };

        M_LEFT_R {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <45 31>;
        };

        M_RIGHT_L {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <25 37>;
        };

        M_RIGHT_R {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <34 48>;
        };

        CMD_TAB_L {
            bindings = <&kp LG(TAB)>;
            key-positions = <14 15>;
        };

        CMD_TAB_R {
            bindings = <&kp LG(TAB)>;
            key-positions = <21 22>;
        };

        CAPS_L {
            bindings = <&kp CAPS>;
            key-positions = <40 41>;
        };       

        FROM_LAYERS_TO_ADJ_LAYER {
            bindings = <&tog ADJ_LAYER>;
            key-positions = <10 11>;
            layers = <FUNCT_LAYER LAYERS_LAYER ADJ_LAYER>;
        };

        ENTER_R {
            bindings = <&kp ENTER>;
            key-positions = <46 47>;
        };

        ENTER_L {
            bindings = <&kp ENTER>;
            key-positions = <38 39>;
        };

        N0_L {
            bindings = <&kp N0>;
            key-positions = <27 28>;
            layers = <NUM_LAYER>;
        };

        N0_R {
            bindings = <&kp N0>;
            key-positions = <31 32>;
            layers = <NUM_LAYER>;
        };

        N0_L1 {
            bindings = <&kp N0>;
            key-positions = <39 40>;
            layers = <NUM_LAYER>;
        };

        N0_R2 {
            bindings = <&kp N0>;
            key-positions = <45 46>;
            layers = <NUM_LAYER>;
        };
        
        MOUSE1_ML_L {
                    bindings = <&mkp MB1>;
                    key-positions = <28 27>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };
        
                MOUSE2_ML_L {
                    bindings = <&mkp MB2>;
                    key-positions = <28 27 26>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };
        
                MOUSE1_ML_R {
                    bindings = <&mkp MB1>;
                    key-positions = <31 32>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };
        
                MOUSE2_ML_R {
                    bindings = <&mkp MB2>;
                    key-positions = <31 32 33>;
                    layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
                };


        MOUSE1_R {
            bindings = <&mkp MB1>;
            key-positions = <45 46>;
        };

        MOUSE2_R {
            bindings = <&mkp MB2>;
            key-positions = <45 46 47>;
        };

        MOUSE1_L {
            bindings = <&mkp MB1>;
            key-positions = <40 39>;
        };

        MOUSE2_L {
            bindings = <&mkp MB2>;
            key-positions = <38 39 40>;
        };

        MOUSE1_UP_R {
            bindings = <&mkp MB1>;
            key-positions = <19 20>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_UP_R {
            bindings = <&mkp MB2>;
            key-positions = <21 20 19>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE1_UP_L {
            bindings = <&mkp MB1>;
            key-positions = <16 15>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_UP_L {
            bindings = <&mkp MB2>;
            key-positions = <14 15 16>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        UI_REVERT {
            bindings = <&kp RG(Z)>;
            key-positions = <20 19>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UIO_REPEAT {
            bindings = <&kp LS(LG(Z))>;
            key-positions = <20 21>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UI_REVERT_L {
            bindings = <&kp RG(Z)>;
            key-positions = <15 16>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UIO_REPEAT_L {
            bindings = <&kp LS(LG(Z))>;
            key-positions = <14 15>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        CAPS_WORLD {
            bindings = <&my_caps_word>;
            key-positions = <27 28 31 32>;
            layers = <BASE_LAYER BASE_ADD_LAYER BASE_MIRROR_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
        };
        
        TO_BASE_L {
                    bindings = <&to BASE_LAYER>;
                    key-positions = <16 28 29 17>;
                };
        
                TO_BASE_R {
                    bindings = <&to BASE_LAYER>;
                    key-positions = <18 19 31 30>;
                };
                
        BT_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <5 4>;
            layers = <FUNCT_LAYER>;
        };

        BT_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <4 3>;
            layers = <FUNCT_LAYER>;
        };

        BT_2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <3 2>;
            layers = <FUNCT_LAYER>;
        };

        BT_3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <2 1>;
            layers = <FUNCT_LAYER>;
        };

        BT_4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <1 0>;
            layers = <FUNCT_LAYER>;
        };

        BT_CLEAR {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 1 2 3>;
            layers = <FUNCT_LAYER>;
        };
         
         QUESTION_RUEN {
                           bindings = <&kp RS(SLASH)>;
                           key-positions = <47 48>;
                           layers = <BASE_LAYER BASE_ADD_LAYER>;
                        };
                        
                        QUESTION_RUEN2 {
                                                   bindings = <&kp RS(SLASH)>;
                                                   key-positions = <33 34>;
                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                };
                                                
    SLASH_HIGH {
                                                       bindings = <&kp SLASH>;
                                                       key-positions = <30 31>;
                                                       layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                    };
                                                                                      
                                                    SLASH_DOWN {
                                                                                                                                                   bindings = <&kp BSLH>;
                                                                                                                                                   key-positions = <44 45>;
                                                                                                                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                                                                                                                };
                                                  
                        UI_RU {
                                                   bindings = <&kp LBKT>;
                                                   key-positions = <19 20>;
                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                };
                        
                        IO_RU {
                                                   bindings = <&kp RBKT>;
                                                   key-positions = <20 21>;
                                                   layers = <BASE_LAYER BASE_ADD_LAYER>;
                                                };                      
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R          &kp T                          &kp Y  &kp U         &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F   &kp G                          &kp H  &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V          &kp B                          &kp N  &kp M         &kp COMMA     &kp DOT      &kp SQT
                                          &kp BACKSPACE  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp TAB
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp N1         &kp N2    &kp N3     &kp N4     &kp N5                        &kp N6           &kp N7           &kp N8           &kp N9        &kp N0
  &hml LGUI ESC  &kp LALT  &kp LSHFT  &kp LCTRL  &kp ENTER                     &kp PRINTSCREEN  &hmr RCTRL LEFT  &hmr RSHFT DOWN  &hmr LALT UP  &hmr RGUI RIGHT
  &none          &kp HOME  &kp INS    &kp END    &kp DELETE                    &kp CAPS         &none            &kp PG_DN        &kp PG_UP     &none
                                      &trans     &trans      &trans    &trans  &mo 3            &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
  &none           &kp LT          &kp EQUAL         &kp GT           &kp GRAVE                    &kp CARET  &kp LBKT         &kp UNDER        &kp RBKT        &none
  &hml LGUI BSLH  &hml LALT LPAR  &hml LSHFT MINUS  &hml LCTRL RPAR  &kp PLUS                     &kp PRCNT  &hmr RCTRL LBRC  &hmr RSHFT SEMI  &hmr LALT RBRC  &hmr RGUI EXCL
  &kp HASH        &kp STAR        &kp COLON         &kp FSLH         &none                        &none      &kp PIPE         &kp TILDE        &kp AMPS        &kp DLLR
                                                    &trans           &mo 3      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_CLR
  &kp LGUI     &hml LALT F5  &hml LSHFT F6  &hml LCTRL F7  &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9        &kp F10        &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                            &trans         &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
