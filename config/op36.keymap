#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// Константы для перемещений

#define BASE_LAYER 0
#define BASE_ADD_LAYER 1
#define BASE_MIRROR_LAYER 2
#define NAV_R_LAYER 3
#define NAV_L_LAYER 4
#define NAV_MOUSE_R_LAYER 5
#define NAV_MOUSE_L_LAYER 6
#define FUNCT_LAYER 7
#define NUM_LAYER 8
#define SYMB_LAYER 9
#define LAYERS_LAYER 10
#define ADJ_LAYER 11
#define BASE_OVERRIDE_LAYER 12
#define BASE_ADD_OVERRIDE_LAYER 13

#define MMV_SLOW_ALT_SPEED 250
#define MMV_SLOW_ALT_SPEED_L -250
#define MMV_SLOW_ALT_SPEED_U -250
#define MMV_SLOW_ALT_SPEED_D 250
#define MMV_SLOW_ALT_SPEED_R 250

//

#define MMV_FAST_ALT_SPEED_X 950
#define MMV_FAST_ALT_SPEED_Y 950
#define MMV_FAST_ALT_SPEED_L -950
#define MMV_FAST_ALT_SPEED_U -950
#define MMV_FAST_ALT_SPEED_D 950
#define MMV_FAST_ALT_SPEED_R 950

//

#define MMV_FAST_SPEED_X 700
#define MMV_FAST_SPEED_Y 480
#define MMV_FAST_SPEED_L -MMV_FAST_SPEED_X
#define MMV_FAST_SPEED_U -MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_D MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_R MMV_FAST_SPEED_X

//
// 1100x750, 700x480, 600x410
#define MMV_SUPER_FAST_SPEED_X 1100
#define MMV_SUPER_FAST_SPEED_Y 750
#define MMV_SUPER_FAST_SPEED_L -MMV_SUPER_FAST_SPEED_X
#define MMV_SUPER_FAST_SPEED_U -MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_D MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_R MMV_SUPER_FAST_SPEED_X

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_ru.h"

&mt {
  tapping-term-ms = <180>;
  flavor = "balanced";
  quick-tap-ms = <50>;
};

&msc {
  time-to-max-speed-ms = <8>;
  acceleration-exponent = <5>;
};

&mmv {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <100>;
  delay-ms = <0>;
};

&lt {
  tapping-term-ms = <171>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
        
        
         my_caps_word: my_caps_word {
                compatible = "zmk,behavior-caps-word";
                label = "MY_CAPS_WORD";
                #binding-cells = <0>;
                continue-list = <UNDERSCORE MINUS COMMA PERIOD SEMICOLON SPACE>;
             };
                    
            enc_vol: enc_vol {
              compatible = "zmk,behavior-sensor-rotate";
              label = "ENC_VOL";
              #sensor-binding-cells = <0>;
              bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
            };
                
            // ru-б en/alt-ru ,
            alt_ru_en_comma: alt_ru_en_comma {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_COMMA";
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp RS(N6)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            // ru-ж en/alt-ru
            alt_ru_en_semi: alt_ru_en_semi {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_SEMI";
              #binding-cells = <0>;
              bindings = <&mt RGUI SEMI>, <&kp RS(N8)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            // ru-э en/alt-ru "
            alt_ru_en_sqt: alt_ru_en_sqt {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_SQT";
              #binding-cells = <0>;
              bindings = <&kp SQT>, <&kp RS(N2)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };                       
        
            ctrl_left_bracket: ctrl_left_bracket {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_LEFT_BRACKET";
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp LEFT_BRACKET>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            ctrl_right_bracket: ctrl_right_bracket {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_RIGHT_BRACKET";
              #binding-cells = <0>;
              bindings = <&kp DOT>, <&kp RIGHT_BRACKET>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            ctrl_p_sqt: ctrl_p_sqt {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_P_SQT";
              #binding-cells = <0>;
              bindings = <&kp P>, <&kp SQT>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
            
            ralt_y_up3: ralt_y_up3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_Y_UP3";
              #binding-cells = <0>;
              bindings = 
                <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_y_down3: ralt_y_down3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_Y_DOWN3";
              #binding-cells = <0>;
              bindings = 
                <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_x_left3: ralt_x_left3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_X_LEFT3";
              #binding-cells = <0>;
              bindings =
                <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_x_right3: ralt_x_right3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_X_RIGHT3";
              #binding-cells = <0>;
              bindings =
                <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
              mods = <(MOD_RALT)>;
            };
            
            /* */
            ralt_y_up_f: ralt_y_up_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_y_up_f";
                  #binding-cells = <0>;
                  bindings = 
                    <&kp UP_ARROW>,
                    <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_y_down_f: ralt_y_down_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_y_down_f";
                  #binding-cells = <0>;
                  bindings = 
                    <&kp DOWN>,
                    <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_x_left_f: ralt_x_left_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_x_left_f";
                  #binding-cells = <0>;
                  bindings =
                    <&kp LEFT>,
                    <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_x_right_f: ralt_x_right_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_x_right_f";
                  #binding-cells = <0>;
                  bindings =
                    <&kp RIGHT>,
                    <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
                  mods = <(MOD_RALT)>;
                };
            /* */
        
            /* mouse 0 layer */
            ralt_base_left: ralt_base_left {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_left";
              #binding-cells = <0>;
              bindings =
                <&kp M>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_up: ralt_base_up {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_BASE_UP";
              #binding-cells = <0>;
              bindings = 
                <&kp COMMA>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_down: ralt_base_down {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_down";
              #binding-cells = <0>;
              bindings = 
                <&kp DOT>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_right: ralt_base_right {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_right";
              #binding-cells = <0>;
              bindings =
                <&kp SLASH>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
              mods = <(MOD_RALT)>;
            };
            /* end mouse 0 layer */
        
            layer_lt_tap: layer_lt_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_LT_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&lt>, <&kp>;
            };
        
            layer_hold_tap: layer_hold_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_HOLD_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&tog>, <&kp>;
            };
        
            layer_to_tap: layer_to_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_TO_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&to>, <&kp>;
            };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        hrdsgn {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };
    };

keymap {
    compatible = "zmk,keymap";

    base {
      bindings = <
        /* base B L */
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        /* base B R */
        &kp Y
        &kp U
        &kp I
        &kp O
        &kp P

        /* base C L */
        &mt LGUI A
        &mt LCTRL S
        &mt LALT D
        &mt LSHFT F
        &lt BASE_ADD_LAYER G
        /* base C R */
        &lt BASE_ADD_LAYER H
        &mt RSHIFT J
        &mt RALT K
        &mt RCTRL L
        &mt RGUI SEMI

        /* base D L */
        &lt BASE_ADD_LAYER Z
        &kp X
        &kp C
        &kp V
        &kp B
        /* base D R */
        &kp N
        &kp M
        &kp COMMA
        &kp DOT
        &lt BASE_ADD_LAYER SQT

        /* base T L */
        &lt SYMB_LAYER TAB
        &lt NAV_L_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* base T R */
        &lt FUNCT_LAYER ESC
        &lt NAV_R_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
      >;
      display-name = "base";
    };  

    baise_mirror {
      bindings = <      
              /* base-m B L */
                            &kp P
                            &kp O
                            &kp I
                            &kp U
                            &kp Y
              /* base-m B R */
              &kp T
              &kp R
              &kp E
              &kp W
              &kp Q
              
              /* base-m C L */
              &mt LGUI SEMI
              &mt LCTRL L
              &mt LALT K
              &mt LSHFT J
              &kp H
              /* base-m C R */
              &kp G
              &mt RSHIFT F
              &mt RALT D
              &mt RCTRL S
              &mt RGUI A
      
              /* base-m D L */
              &kp SLASH
              &kp DOT
              &kp COMMA
              &kp M
              &kp N
              /* base-m D R */
              &kp B
              &kp V
              &kp C
              &kp X
              &kp Z

              /* base-m T L */
              &lt NUM_LAYER BACKSPACE
              &lt NAV_R_LAYER RG(RC(SPACE))
              &lt FUNCT_LAYER ESC
              /* base-m T R */
              &lt FUNCT_LAYER DEL
              &lt NAV_L_LAYER SPACE
              &lt SYMB_LAYER TAB
            >;
      display-name = "base-mirror";
    };
    
    nav-r {
      bindings = <
        /* nav-r B L */
        &kp LEFT_ARROW
        &kp DOWN
        &kp UP
        &kp RIGHT_ARROW
        &tog NAV_R_LAYER
        /* nav-r B R */
        &tog NAV_R_LAYER
        &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
                &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)
                &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
                &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
        
        /* nav-r C L */        
        &kp LGUI
        &kp LCTRL
        &kp LALT
        &kp LSHFT
        &msc SCRL_UP
        /* nav-r C R */
        &msc SCRL_UP
        &kp LEFT_ARROW
        &kp UP
        &kp DOWN
        &kp RIGHT_ARROW

        /* nav-r D L */
        &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)
        &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)
        &msc SCRL_DOWN
        /* nav-r D R */
        &msc SCRL_DOWN
        &mmv MOVE_X(MMV_FAST_SPEED_L)
                &mmv MOVE_Y(MMV_FAST_SPEED_U)
                &mmv MOVE_Y(MMV_FAST_SPEED_D)        
                &mmv MOVE_X(MMV_FAST_SPEED_R)

        /* nav-r T L */
        &lt SYMB_LAYER TAB
        &lt BASE_OVERRIDE_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* nav-r T R */
        &lt FUNCT_LAYER ESC
        &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
      >;
      display-name = "nav-r";
    };
    
nav-l {
  bindings = <
    /* nav-l B L */
    &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
    &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
    &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)                    
    &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
    &tog NAV_L_LAYER
    /* nav-l B R */
    &tog NAV_L_LAYER
    &kp LEFT_ARROW      
    &kp UP                      
    &kp DOWN
    &kp RIGHT_ARROW
    /* nav-l C L */
    &kp LEFT_ARROW
    &kp DOWN
    &kp UP
    &kp RIGHT_ARROW   
    &msc SCRL_UP
    /* nav-l C R */
    &msc SCRL_UP
    &kp LSHFT
    &kp LALT
    &kp LCTRL
    &kp LGUI

    /* nav-l D L */
    &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)                    
        &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)
    &msc SCRL_DOWN    
    /* nav-l D R */
    &msc SCRL_DOWN
    &mmv MOVE_X(MMV_FAST_SPEED_L)
    &mmv MOVE_Y(MMV_FAST_SPEED_U)        
    &mmv MOVE_Y(MMV_FAST_SPEED_D)    
    &mmv MOVE_X(MMV_FAST_SPEED_R)
    /* nav-l T L */            
    &lt SYMB_LAYER TAB
    &lt BASE_OVERRIDE_LAYER SPACE
    &lt FUNCT_LAYER DEL
    /* nav-l T R */
    &lt FUNCT_LAYER ESC
    &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
    &lt NUM_LAYER BACKSPACE
  >;
  display-name = "nav-l";
};

nav-mouse-r {
      bindings = <
              /* nav-m-r B L */
              &kp LEFT_ARROW
              &kp DOWN
              &kp UP
              &kp RIGHT_ARROW
              &tog NAV_MOUSE_R_LAYER              
              /* nav-m-r B R */
              &tog NAV_MOUSE_R_LAYER
              &kp LEFT_ARROW
              &kp UP
              &kp DOWN
              &kp RIGHT_ARROW
              /* nav-m-r C L */        
              &kp LGUI
              &kp LCTRL
              &kp LALT
              &kp LSHFT
              &msc SCRL_UP
              /* nav-m-r C R */
              &msc SCRL_UP
              &mmv MOVE_X(MMV_FAST_SPEED_L)
              &mmv MOVE_Y(MMV_FAST_SPEED_U)
              &mmv MOVE_Y(MMV_FAST_SPEED_D)        
              &mmv MOVE_X(MMV_FAST_SPEED_R)        
      
              /* nav-m-r D L */
              &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
              &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
              &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)
              &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)
              &msc SCRL_DOWN
              /* nav-m-r D R */
              &msc SCRL_DOWN
              &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
                      &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)
                      &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
                      &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
      
              /* nav-m-r T L */
              &lt SYMB_LAYER TAB
              &lt BASE_OVERRIDE_LAYER SPACE
              &lt FUNCT_LAYER DEL
              /* nav-m-r T R */
              &lt FUNCT_LAYER ESC
              &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
              &lt NUM_LAYER BACKSPACE
            >;
      display-name = "nav-mouse-r";
    };

  
    
    };
};
