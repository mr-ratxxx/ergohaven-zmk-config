#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// Константы для перемещений

#define BASE_LAYER 0
#define BASE_ADD_LAYER 1
#define BASE_MIRROR_LAYER 2
#define NAV_R_LAYER 3
#define NAV_L_LAYER 4
#define NAV_MOUSE_R_LAYER 5
#define NAV_MOUSE_L_LAYER 6
#define FUNCT_LAYER 7
#define NUM_LAYER 8
#define SYMB_LAYER 9
#define LAYERS_LAYER 10
#define ADJ_LAYER 11
#define BASE_OVERRIDE_LAYER 12
#define BASE_ADD_OVERRIDE_LAYER 13

#define MMV_SLOW_ALT_SPEED 250
#define MMV_SLOW_ALT_SPEED_L -250
#define MMV_SLOW_ALT_SPEED_U -250
#define MMV_SLOW_ALT_SPEED_D 250
#define MMV_SLOW_ALT_SPEED_R 250

//

#define MMV_FAST_ALT_SPEED_X 950
#define MMV_FAST_ALT_SPEED_Y 950
#define MMV_FAST_ALT_SPEED_L -950
#define MMV_FAST_ALT_SPEED_U -950
#define MMV_FAST_ALT_SPEED_D 950
#define MMV_FAST_ALT_SPEED_R 950

//

#define MMV_FAST_SPEED_X 700
#define MMV_FAST_SPEED_Y 480
#define MMV_FAST_SPEED_L -MMV_FAST_SPEED_X
#define MMV_FAST_SPEED_U -MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_D MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_R MMV_FAST_SPEED_X

//
// 1100x750, 700x480, 600x410
#define MMV_SUPER_FAST_SPEED_X 1100
#define MMV_SUPER_FAST_SPEED_Y 750
#define MMV_SUPER_FAST_SPEED_L -MMV_SUPER_FAST_SPEED_X
#define MMV_SUPER_FAST_SPEED_U -MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_D MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_R MMV_SUPER_FAST_SPEED_X

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_ru.h"

&mt {
  tapping-term-ms = <180>;
  flavor = "balanced";
  quick-tap-ms = <50>;
};

&msc {
  time-to-max-speed-ms = <8>;
  acceleration-exponent = <5>;
};

&mmv {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <100>;
  delay-ms = <0>;
};

&lt {
  tapping-term-ms = <171>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
        
        
         my_caps_word: my_caps_word {
                compatible = "zmk,behavior-caps-word";
                label = "MY_CAPS_WORD";
                #binding-cells = <0>;
                continue-list = <UNDERSCORE MINUS COMMA PERIOD SEMICOLON SPACE>;
             };
                    
            enc_vol: enc_vol {
              compatible = "zmk,behavior-sensor-rotate";
              label = "ENC_VOL";
              #sensor-binding-cells = <0>;
              bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
            };
                
            // ru-б en/alt-ru ,
            alt_ru_en_comma: alt_ru_en_comma {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_COMMA";
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp RS(N6)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            // ru-ж en/alt-ru
            alt_ru_en_semi: alt_ru_en_semi {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_SEMI";
              #binding-cells = <0>;
              bindings = <&mt RGUI SEMI>, <&kp RS(N8)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            // ru-э en/alt-ru "
            alt_ru_en_sqt: alt_ru_en_sqt {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_SQT";
              #binding-cells = <0>;
              bindings = <&kp SQT>, <&kp RS(N2)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };                       
        
            ctrl_left_bracket: ctrl_left_bracket {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_LEFT_BRACKET";
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp LEFT_BRACKET>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            ctrl_right_bracket: ctrl_right_bracket {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_RIGHT_BRACKET";
              #binding-cells = <0>;
              bindings = <&kp DOT>, <&kp RIGHT_BRACKET>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            ctrl_p_sqt: ctrl_p_sqt {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_P_SQT";
              #binding-cells = <0>;
              bindings = <&kp P>, <&kp SQT>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
            
            ralt_y_up3: ralt_y_up3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_Y_UP3";
              #binding-cells = <0>;
              bindings = 
                <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_y_down3: ralt_y_down3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_Y_DOWN3";
              #binding-cells = <0>;
              bindings = 
                <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_x_left3: ralt_x_left3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_X_LEFT3";
              #binding-cells = <0>;
              bindings =
                <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_x_right3: ralt_x_right3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_X_RIGHT3";
              #binding-cells = <0>;
              bindings =
                <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
              mods = <(MOD_RALT)>;
            };
            
            /* */
            ralt_y_up_f: ralt_y_up_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_y_up_f";
                  #binding-cells = <0>;
                  bindings = 
                    <&kp UP_ARROW>,
                    <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_y_down_f: ralt_y_down_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_y_down_f";
                  #binding-cells = <0>;
                  bindings = 
                    <&kp DOWN>,
                    <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_x_left_f: ralt_x_left_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_x_left_f";
                  #binding-cells = <0>;
                  bindings =
                    <&kp LEFT>,
                    <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_x_right_f: ralt_x_right_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_x_right_f";
                  #binding-cells = <0>;
                  bindings =
                    <&kp RIGHT>,
                    <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
                  mods = <(MOD_RALT)>;
                };
            /* */
        
            /* mouse 0 layer */
            ralt_base_left: ralt_base_left {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_left";
              #binding-cells = <0>;
              bindings =
                <&kp M>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_up: ralt_base_up {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_BASE_UP";
              #binding-cells = <0>;
              bindings = 
                <&kp COMMA>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_down: ralt_base_down {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_down";
              #binding-cells = <0>;
              bindings = 
                <&kp DOT>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_right: ralt_base_right {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_right";
              #binding-cells = <0>;
              bindings =
                <&kp SLASH>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
              mods = <(MOD_RALT)>;
            };
            /* end mouse 0 layer */
        
            layer_lt_tap: layer_lt_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_LT_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&lt>, <&kp>;
            };
        
            layer_hold_tap: layer_hold_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_HOLD_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&tog>, <&kp>;
            };
        
            layer_to_tap: layer_to_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_TO_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&to>, <&kp>;
            };
    };

    combos {
        compatible = "zmk,combos";

        kha {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
        };

        hrdsgn {
            bindings = <&kp RBKT>;
            key-positions = <7 8>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
  &kp Q        &kp W        &kp E         &kp R          &kp T                          &kp Y  &kp U         &kp I         &kp O        &kp P
  &hml LGUI A  &hml LALT S  &hml LSHFT D  &hml LCTRL F   &kp G                          &kp H  &hmr RCTRL J  &hmr RSHFT K  &hmr LALT L  &hmr RGUI SEMICOLON
  &kp Z        &kp X        &kp C         &kp V          &kp B                          &kp N  &kp M         &kp COMMA     &kp DOT      &kp SQT
                                          &kp BACKSPACE  &mo 1  &kp SPACE    &kp ENTER  &mo 2  &kp TAB
            >;

            display-name = "Base";
        };

        nav {
            bindings = <
  &kp N1         &kp N2    &kp N3     &kp N4     &kp N5                        &kp N6           &kp N7           &kp N8           &kp N9        &kp N0
  &hml LGUI ESC  &kp LALT  &kp LSHFT  &kp LCTRL  &kp ENTER                     &kp PRINTSCREEN  &hmr RCTRL LEFT  &hmr RSHFT DOWN  &hmr LALT UP  &hmr RGUI RIGHT
  &none          &kp HOME  &kp INS    &kp END    &kp DELETE                    &kp CAPS         &none            &kp PG_DN        &kp PG_UP     &none
                                      &trans     &trans      &trans    &trans  &mo 3            &trans
            >;

            display-name = "Nav";
        };

        sym {
            bindings = <
  &none           &kp LT          &kp EQUAL         &kp GT           &kp GRAVE                    &kp CARET  &kp LBKT         &kp UNDER        &kp RBKT        &none
  &hml LGUI BSLH  &hml LALT LPAR  &hml LSHFT MINUS  &hml LCTRL RPAR  &kp PLUS                     &kp PRCNT  &hmr RCTRL LBRC  &hmr RSHFT SEMI  &hmr LALT RBRC  &hmr RGUI EXCL
  &kp HASH        &kp STAR        &kp COLON         &kp FSLH         &none                        &none      &kp PIPE         &kp TILDE        &kp AMPS        &kp DLLR
                                                    &trans           &mo 3      &trans    &trans  &trans     &trans
            >;

            display-name = "Symbols";
        };

        adj {
            bindings = <
  &bootloader  &kp F1        &kp F2         &kp F3         &kp F4                     &bt BT_SEL 0  &bt BT_SEL 1         &bt BT_SEL 2       &bt BT_SEL 3        &bt BT_CLR
  &kp LGUI     &hml LALT F5  &hml LSHFT F6  &hml LCTRL F7  &kp F8                     &out OUT_BLE  &hmr RCTRL C_VOL_DN  &hmr RSHFT C_MUTE  &hmr LALT C_VOL_UP  &kp RGUI
  &none        &kp F9        &kp F10        &kp F11        &kp F12                    &out OUT_USB  &kp C_PREV           &kp C_PP           &kp C_NEXT          &studio_unlock
                                            &trans         &trans   &trans    &trans  &trans        &trans
            >;

            display-name = "Adjust";
        };
    };
};
