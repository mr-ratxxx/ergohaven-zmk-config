#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// Константы для перемещений

#define BASE_LAYER 0
#define BASE_ADD_LAYER 1
#define BASE_MIRROR_LAYER 2
#define NAV_R_LAYER 3
#define NAV_L_LAYER 4
#define NAV_MOUSE_R_LAYER 5
#define NAV_MOUSE_L_LAYER 6
#define FUNCT_LAYER 7
#define NUM_LAYER 8
#define SYMB_LAYER 9
#define LAYERS_LAYER 10
#define ADJ_LAYER 11
#define BASE_OVERRIDE_LAYER 12
#define BASE_ADD_OVERRIDE_LAYER 13

#define MMV_SLOW_ALT_SPEED 250
#define MMV_SLOW_ALT_SPEED_L -250
#define MMV_SLOW_ALT_SPEED_U -250
#define MMV_SLOW_ALT_SPEED_D 250
#define MMV_SLOW_ALT_SPEED_R 250

//

#define MMV_FAST_ALT_SPEED_X 950
#define MMV_FAST_ALT_SPEED_Y 950
#define MMV_FAST_ALT_SPEED_L -950
#define MMV_FAST_ALT_SPEED_U -950
#define MMV_FAST_ALT_SPEED_D 950
#define MMV_FAST_ALT_SPEED_R 950

//

#define MMV_FAST_SPEED_X 700
#define MMV_FAST_SPEED_Y 480
#define MMV_FAST_SPEED_L -MMV_FAST_SPEED_X
#define MMV_FAST_SPEED_U -MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_D MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_R MMV_FAST_SPEED_X

//
// 1100x750, 700x480, 600x410
#define MMV_SUPER_FAST_SPEED_X 1100
#define MMV_SUPER_FAST_SPEED_Y 750
#define MMV_SUPER_FAST_SPEED_L -MMV_SUPER_FAST_SPEED_X
#define MMV_SUPER_FAST_SPEED_U -MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_D MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_R MMV_SUPER_FAST_SPEED_X

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "keys_ru.h"

&mt {
  tapping-term-ms = <180>;
  flavor = "balanced";
  quick-tap-ms = <50>;
};

&msc {
  time-to-max-speed-ms = <8>;
  acceleration-exponent = <5>;
};

&mmv {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <100>;
  delay-ms = <0>;
};

&lt {
  tapping-term-ms = <171>;
};

/ {
    behaviors {
        hml: home_row_mod_left {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <5 6 7 8 9 15 16 17 18 19 25 26 27 28 29 33 34 35>;
            hold-trigger-on-release;
        };

        hmr: home_row_mod_right {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "balanced";
            require-prior-idle-ms = <150>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            bindings = <&kp>, <&kp>;

            hold-trigger-key-positions = <0 1 2 3 4 10 11 12 13 14 20 21 22 23 24 30 31 32>;
            hold-trigger-on-release;
        };
        
        
         my_caps_word: my_caps_word {
                compatible = "zmk,behavior-caps-word";
                label = "MY_CAPS_WORD";
                #binding-cells = <0>;
                continue-list = <UNDERSCORE MINUS COMMA PERIOD SEMICOLON SPACE>;
             };
                    
            enc_vol: enc_vol {
              compatible = "zmk,behavior-sensor-rotate";
              label = "ENC_VOL";
              #sensor-binding-cells = <0>;
              bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
            };
                
            // ru-б en/alt-ru ,
            alt_ru_en_comma: alt_ru_en_comma {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_COMMA";
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp RS(N6)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            // ru-ж en/alt-ru
            alt_ru_en_semi: alt_ru_en_semi {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_SEMI";
              #binding-cells = <0>;
              bindings = <&mt RGUI SEMI>, <&kp RS(N8)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            // ru-э en/alt-ru "
            alt_ru_en_sqt: alt_ru_en_sqt {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_RU_EN_SQT";
              #binding-cells = <0>;
              bindings = <&kp SQT>, <&kp RS(N2)>;
              mods = <(MOD_LALT | MOD_RALT)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };                       
        
            ctrl_left_bracket: ctrl_left_bracket {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_LEFT_BRACKET";
              #binding-cells = <0>;
              bindings = <&kp COMMA>, <&kp LEFT_BRACKET>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            ctrl_right_bracket: ctrl_right_bracket {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_RIGHT_BRACKET";
              #binding-cells = <0>;
              bindings = <&kp DOT>, <&kp RIGHT_BRACKET>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
        
            ctrl_p_sqt: ctrl_p_sqt {
              compatible = "zmk,behavior-mod-morph";
              label = "CTRL_P_SQT";
              #binding-cells = <0>;
              bindings = <&kp P>, <&kp SQT>;
              mods = <(MOD_LCTL | MOD_RCTL)>;
              keep-mods = <(MOD_LCTL | MOD_RCTL)>;
            };
            
            ralt_y_up3: ralt_y_up3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_Y_UP3";
              #binding-cells = <0>;
              bindings = 
                <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_y_down3: ralt_y_down3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_Y_DOWN3";
              #binding-cells = <0>;
              bindings = 
                <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_x_left3: ralt_x_left3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_X_LEFT3";
              #binding-cells = <0>;
              bindings =
                <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_x_right3: ralt_x_right3 {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_X_RIGHT3";
              #binding-cells = <0>;
              bindings =
                <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
              mods = <(MOD_RALT)>;
            };
            
            /* */
            ralt_y_up_f: ralt_y_up_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_y_up_f";
                  #binding-cells = <0>;
                  bindings = 
                    <&kp UP_ARROW>,
                    <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_y_down_f: ralt_y_down_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_y_down_f";
                  #binding-cells = <0>;
                  bindings = 
                    <&kp DOWN>,
                    <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_x_left_f: ralt_x_left_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_x_left_f";
                  #binding-cells = <0>;
                  bindings =
                    <&kp LEFT>,
                    <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
                  mods = <(MOD_RALT)>;
                };
            
                ralt_x_right_f: ralt_x_right_f {
                  compatible = "zmk,behavior-mod-morph";
                  label = "ralt_x_right_f";
                  #binding-cells = <0>;
                  bindings =
                    <&kp RIGHT>,
                    <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
                  mods = <(MOD_RALT)>;
                };
            /* */
        
            /* mouse 0 layer */
            ralt_base_left: ralt_base_left {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_left";
              #binding-cells = <0>;
              bindings =
                <&kp M>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_up: ralt_base_up {
              compatible = "zmk,behavior-mod-morph";
              label = "RALT_BASE_UP";
              #binding-cells = <0>;
              bindings = 
                <&kp COMMA>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_down: ralt_base_down {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_down";
              #binding-cells = <0>;
              bindings = 
                <&kp DOT>,
                <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
              mods = <(MOD_RALT)>;
            };
        
            ralt_base_right: ralt_base_right {
              compatible = "zmk,behavior-mod-morph";
              label = "ralt_base_right";
              #binding-cells = <0>;
              bindings =
                <&kp SLASH>,
                <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
              mods = <(MOD_RALT)>;
            };
            /* end mouse 0 layer */
        
            layer_lt_tap: layer_lt_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_LT_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&lt>, <&kp>;
            };
        
            layer_hold_tap: layer_hold_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_HOLD_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&tog>, <&kp>;
            };
        
            layer_to_tap: layer_to_tap {
              compatible = "zmk,behavior-hold-tap";
              label = "LAYER_TO_TAP";
              #binding-cells = <2>;
              tapping-term-ms = <180>;
              quick-tap-ms = <0>;
              flavor = "tap-preferred";
              bindings = <&to>, <&kp>;
            };
    };

    combos {
        compatible = "zmk,combos";

        ESC_COMBO {
            bindings = <&kp ESC>;
            key-positions = <0 1>;
            layers = <BASE_LAYER BASE_ADD_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
        };

        RU_E {
            bindings = <&kp BSLH>;
            key-positions = <3 4>;
            layers = <BASE_LAYER BASE_ADD_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
        };

        BACK_L {
            bindings = <&kp RG(LEFT_BRACKET)>;
            key-positions = <12 13>;
            layers = <FUNCT_LAYER>;
        };

        FORWARD_L {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <11 12>;
            layers = <FUNCT_LAYER>;
        };

        BACK_R {
            bindings = <&kp RG(LEFT_BRACKET)>;
            key-positions = <16 17>;
            layers = <FUNCT_LAYER>;
        };

        FORWARD_R {
            bindings = <&kp RG(RIGHT_BRACKET)>;
            key-positions = <17 18>;
            layers = <FUNCT_LAYER>;
        };

        PG_DOWN_L {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <11 1>;
        };

        PG_DOWN_R {
            bindings = <&kp PAGE_DOWN>;
            key-positions = <18 8>;
        };

        CMD_PG_UP_L {
            bindings = <&kp PAGE_UP>;
            key-positions = <12 2>;
        };

        CMD_PG_UP_R {
            bindings = <&kp PAGE_UP>;
            key-positions = <7 17>;
        };

        M_DOWN_L {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <12 22>;
        };

        M_DOWN_R {
            bindings = <&msc SCRL_DOWN>;
            key-positions = <18 28>;
        };

        M_UP_L {
            bindings = <&msc SCRL_UP>;
            key-positions = <12 22>;
        };

        M_UP_R {
            bindings = <&msc SCRL_UP>;
            key-positions = <17 27>;
        };

        M_LEFT_L {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <11 21>;
        };

        M_LEFT_R {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <16 26>;
        };

        M_RIGHT_L {
            bindings = <&msc SCRL_LEFT>;
            key-positions = <13 23>;
        };

        M_RIGHT_R {
            bindings = <&msc SCRL_RIGHT>;
            key-positions = <19 29>;
        };

        CMD_TAB_L {
            bindings = <&kp LG(TAB)>;
            key-positions = <2 1>;
        };

        CMD_TAB_R {
            bindings = <&kp LG(TAB)>;
            key-positions = <9 8>;
        };

        CAPS_L {
            bindings = <&kp CAPS>;
            key-positions = <40 41 24 23>;
        };

        FROM_LAYERS_TO_ADJ_LAYER {
            bindings = <&tog ADJ_LAYER>;
            key-positions = <9 8>;
            layers = <FUNCT_LAYER LAYERS_LAYER ADJ_LAYER>;
        };

        ENTER_R {
            bindings = <&kp ENTER>;
            key-positions = <27 28>;
        };

        ENTER_L {
            bindings = <&kp ENTER>;
            key-positions = <22 21>;
        };

        N0_L {
            bindings = <&kp N0>;
            key-positions = <23 22>;
            layers = <NUM_LAYER>;
        };

        N0_R {
            bindings = <&kp N0>;
            key-positions = <26 27>;
            layers = <NUM_LAYER>;
        };

        MOUSE1_ML_L {
            bindings = <&mkp MB1>;
            key-positions = <13 12>;
            layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_ML_L {
            bindings = <&mkp MB2>;
            key-positions = <13 12 11>;
            layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE1_ML_R {
            bindings = <&mkp MB1>;
            key-positions = <16 17>;
            layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_ML_R {
            bindings = <&mkp MB2>;
            key-positions = <16 17 18>;
            layers = <NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE1_R {
            bindings = <&mkp MB1>;
            key-positions = <26 27>;
        };

        MOUSE2_R {
            bindings = <&mkp MB2>;
            key-positions = <26 27 28>;
        };

        MOUSE1_L {
            bindings = <&mkp MB1>;
            key-positions = <22 23>;
        };

        MOUSE2_L {
            bindings = <&mkp MB2>;
            key-positions = <21 22 23>;
        };

        MOUSE1_UP_R {
            bindings = <&mkp MB1>;
            key-positions = <7 6>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_UP_R {
            bindings = <&mkp MB2>;
            key-positions = <6 7 8>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE1_UP_L {
            bindings = <&mkp MB1>;
            key-positions = <3 2>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        MOUSE2_UP_L {
            bindings = <&mkp MB2>;
            key-positions = <3 2 1>;
            layers = <NAV_R_LAYER NAV_L_LAYER NAV_MOUSE_R_LAYER NAV_MOUSE_L_LAYER>;
        };

        UI_REVERT {
            bindings = <&kp RG(Z)>;
            key-positions = <6 7>;e
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UIO_REPEAT {
            bindings = <&kp LS(LG(Z))>;
            key-positions = <7 8>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UI_REVERT_L {
            bindings = <&kp RG(Z)>;
            key-positions = <2 3>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        UIO_REPEAT_L {
            bindings = <&kp LS(LG(Z))>;
            key-positions = <2 1>;
            layers = <FUNCT_LAYER BASE_OVERRIDE_LAYER LAYERS_LAYER>;
        };

        CAPS_WORLD {
            bindings = <&my_caps_word>;
            key-positions = <16 13 17 12>;
            layers = <BASE_LAYER BASE_ADD_LAYER BASE_MIRROR_LAYER BASE_OVERRIDE_LAYER BASE_ADD_OVERRIDE_LAYER>;
        };

        TO_BASE_L {
            bindings = <&to BASE_LAYER>;
            key-positions = <3 4 13 14>;
        };

        TO_BASE_R {
            bindings = <&to BASE_LAYER>;
            key-positions = <5 6 16 15>;
        };

        BT_0 {
            bindings = <&bt BT_SEL 0>;
            key-positions = <3 4>;
            layers = <FUNCT_LAYER>;
        };

        BT_1 {
            bindings = <&bt BT_SEL 1>;
            key-positions = <2 3>;
            layers = <FUNCT_LAYER>;
        };

        BT_2 {
            bindings = <&bt BT_SEL 2>;
            key-positions = <1 2>;
            layers = <FUNCT_LAYER>;
        };

        BT_3 {
            bindings = <&bt BT_SEL 3>;
            key-positions = <5 6>;
            layers = <FUNCT_LAYER>;
        };

        BT_4 {
            bindings = <&bt BT_SEL 4>;
            key-positions = <6 7>;
            layers = <FUNCT_LAYER>;
        };

        BT_CLEAR {
            bindings = <&bt BT_CLR_ALL>;
            key-positions = <0 1 2 3>;
            layers = <FUNCT_LAYER>;
        };

       QUESTION_RUEN {
            bindings = <&kp RS(SLASH)>;
            key-positions = <18 19>;
            layers = <BASE_LAYER BASE_ADD_LAYER>;
        };

        QUESTION_RUEN2 {
            bindings = <&kp RS(SLASH)>;
            key-positions = <28 29>;
            layers = <BASE_LAYER BASE_ADD_LAYER>;
        };

        SLASH_HIGH {
            bindings = <&kp SLASH>;
            key-positions = <15 16>;
            layers = <BASE_LAYER BASE_ADD_LAYER>;
        };

        SLASH_DOWN {
            bindings = <&kp BSLH>;
            key-positions = <25 26>;
            layers = <BASE_LAYER BASE_ADD_LAYER>;
        };

        UI_RU {
            bindings = <&kp LBKT>;
            key-positions = <6 7>;
            layers = <BASE_LAYER BASE_ADD_LAYER>;
        };

        IO_RU {
            bindings = <&kp RBKT>;
            key-positions = <8 7>;
            layers = <BASE_LAYER BASE_ADD_LAYER>;
        };
    };

keymap {
    compatible = "zmk,keymap";

    base {
      bindings = <
        /* base B L */
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        /* base B R */
        &kp Y
        &kp U
        &kp I
        &kp O
        &kp P

        /* base C L */
        &mt LGUI A
        &mt LCTRL S
        &mt LALT D
        &mt LSHFT F
        &lt BASE_ADD_LAYER G
        /* base C R */
        &lt BASE_ADD_LAYER H
        &mt RSHIFT J
        &mt RALT K
        &mt RCTRL L
        &mt RGUI SEMI

        /* base D L */
        &lt BASE_ADD_LAYER Z
        &kp X
        &kp C
        &kp V
        &kp B
        /* base D R */
        &kp N
        &kp M
        &kp COMMA
        &kp DOT
        &lt BASE_ADD_LAYER SQT

        /* base T L */
        &lt SYMB_LAYER TAB
        &lt NAV_L_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* base T R */
        &lt FUNCT_LAYER ESC
        &lt NAV_R_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
      >;
      display-name = "base";
    };
    
    base-add{
      bindings = <
        /* base-add B L */
        &trans          
        &trans
        &trans
        &trans
        &kp BSLH
        /* base-add B R */
        &trans
        &trans         
        &trans
        &trans                
        &kp GRAVE

        /* base-add C L */
        &trans     
        &trans
        &trans
        &trans
        &trans
        /* base-add C R */
        &trans
        &trans
        &trans
        &trans        
        &kp SQT
        
        /* base-add D L */
        &trans
        &kp MINUS
        &kp EQUAL
        &trans
        &trans
        /* base-add D R */
        &trans
        &trans
        &kp LBKT
        &kp RBKT
        &kp BSLH

        /* base-add T L */
        &trans
        &trans
        &trans
        &trans
        /* base-add T R */
        &trans
        &trans
        &trans
        &trans
      >;
      display-name = "base-add";
    };
    
    baise_mirror {
      bindings = <      
              /* base-m B L */
                            &kp P
                            &kp O
                            &kp I
                            &kp U
                            &kp Y
              /* base-m B R */
              &kp T
              &kp R
              &kp E
              &kp W
              &kp Q
              
              /* base-m C L */
              &mt LGUI SEMI
              &mt LCTRL L
              &mt LALT K
              &mt LSHFT J
              &kp H
              /* base-m C R */
              &kp G
              &mt RSHIFT F
              &mt RALT D
              &mt RCTRL S
              &mt RGUI A
      
              /* base-m D L */
              &kp SLASH
              &kp DOT
              &kp COMMA
              &kp M
              &kp N
              /* base-m D R */
              &kp B
              &kp V
              &kp C
              &kp X
              &kp Z

              /* base-m T L */
              &lt NUM_LAYER BACKSPACE
              &lt NAV_R_LAYER RG(RC(SPACE))
              &lt FUNCT_LAYER ESC
              /* base-m T R */
              &lt FUNCT_LAYER DEL
              &lt NAV_L_LAYER SPACE
              &lt SYMB_LAYER TAB
            >;
      display-name = "base-mirror";
    };
    
    nav-r {
      bindings = <
        /* nav-r B L */
        &kp LEFT_ARROW
        &kp DOWN
        &kp UP
        &kp RIGHT_ARROW
        &tog NAV_R_LAYER
        /* nav-r B R */
        &tog NAV_R_LAYER
        &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
                &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)
                &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
                &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
        
        /* nav-r C L */        
        &kp LGUI
        &kp LCTRL
        &kp LALT
        &kp LSHFT
        &msc SCRL_UP
        /* nav-r C R */
        &msc SCRL_UP
        &kp LEFT_ARROW
        &kp UP
        &kp DOWN
        &kp RIGHT_ARROW

        /* nav-r D L */
        &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)
        &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)
        &msc SCRL_DOWN
        /* nav-r D R */
        &msc SCRL_DOWN
        &mmv MOVE_X(MMV_FAST_SPEED_L)
                &mmv MOVE_Y(MMV_FAST_SPEED_U)
                &mmv MOVE_Y(MMV_FAST_SPEED_D)        
                &mmv MOVE_X(MMV_FAST_SPEED_R)

        /* nav-r T L */
        &lt SYMB_LAYER TAB
        &lt BASE_OVERRIDE_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* nav-r T R */
        &lt FUNCT_LAYER ESC
        &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
      >;
      display-name = "nav-r";
    };
    
nav-l {
  bindings = <
    /* nav-l B L */
    &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
    &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
    &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)                    
    &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
    &tog NAV_L_LAYER
    /* nav-l B R */
    &tog NAV_L_LAYER
    &kp LEFT_ARROW      
    &kp UP                      
    &kp DOWN
    &kp RIGHT_ARROW
    /* nav-l C L */
    &kp LEFT_ARROW
    &kp DOWN
    &kp UP
    &kp RIGHT_ARROW   
    &msc SCRL_UP
    /* nav-l C R */
    &msc SCRL_UP
    &kp LSHFT
    &kp LALT
    &kp LCTRL
    &kp LGUI

    /* nav-l D L */
    &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
        &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)                    
        &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)
    &msc SCRL_DOWN    
    /* nav-l D R */
    &msc SCRL_DOWN
    &mmv MOVE_X(MMV_FAST_SPEED_L)
    &mmv MOVE_Y(MMV_FAST_SPEED_U)        
    &mmv MOVE_Y(MMV_FAST_SPEED_D)    
    &mmv MOVE_X(MMV_FAST_SPEED_R)
    /* nav-l T L */            
    &lt SYMB_LAYER TAB
    &lt BASE_OVERRIDE_LAYER SPACE
    &lt FUNCT_LAYER DEL
    /* nav-l T R */
    &lt FUNCT_LAYER ESC
    &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
    &lt NUM_LAYER BACKSPACE
  >;
  display-name = "nav-l";
};

nav-mouse-r {
      bindings = <
              /* nav-m-r B L */
              &kp LEFT_ARROW
              &kp DOWN
              &kp UP
              &kp RIGHT_ARROW
              &tog NAV_MOUSE_R_LAYER              
              /* nav-m-r B R */
              &tog NAV_MOUSE_R_LAYER
              &kp LEFT_ARROW
              &kp UP
              &kp DOWN
              &kp RIGHT_ARROW
              /* nav-m-r C L */        
              &kp LGUI
              &kp LCTRL
              &kp LALT
              &kp LSHFT
              &msc SCRL_UP
              /* nav-m-r C R */
              &msc SCRL_UP
              &mmv MOVE_X(MMV_FAST_SPEED_L)
              &mmv MOVE_Y(MMV_FAST_SPEED_U)
              &mmv MOVE_Y(MMV_FAST_SPEED_D)        
              &mmv MOVE_X(MMV_FAST_SPEED_R)        
      
              /* nav-m-r D L */
              &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
              &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
              &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)
              &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)
              &msc SCRL_DOWN
              /* nav-m-r D R */
              &msc SCRL_DOWN
              &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
                      &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)
                      &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
                      &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
      
              /* nav-m-r T L */
              &lt SYMB_LAYER TAB
              &lt BASE_OVERRIDE_LAYER SPACE
              &lt FUNCT_LAYER DEL
              /* nav-m-r T R */
              &lt FUNCT_LAYER ESC
              &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
              &lt NUM_LAYER BACKSPACE
            >;
      display-name = "nav-mouse-r";
    };

  nav-mouse-l {
    bindings = <
            /* nav-m-l B L */
                     &kp LEFT
                               &kp DOWN
                               &kp UP
                               &kp RIGHT
             &tog NAV_MOUSE_L_LAYER
            /* nav-m-l B R */
            &tog NAV_MOUSE_L_LAYER
            &kp LEFT_ARROW
            &kp UP
            &kp DOWN          
            &kp RIGHT_ARROW
                      
            /* nav-m-l C L */        
            &mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)
                      &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)
                      &mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)
                      &mmv MOVE_X(MMV_SUPER_FAST_SPEED_R) 
            &msc SCRL_UP
            /* nav-m-l C R */
            &msc SCRL_UP
            &kp LSHFT
            &kp LALT
                    &kp LCTRL                  
            &kp LGUI        
    
            /* nav-m-l D L */
            &mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)
                                        &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)
                                        &mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)
                                        &mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)
            &msc SCRL_DOWN
            /* nav-m-l D R */
            &msc SCRL_DOWN
            &mmv MOVE_X(MMV_FAST_SPEED_L) 
                                          &mmv MOVE_Y(MMV_FAST_SPEED_U)
                                          &mmv MOVE_Y(MMV_FAST_SPEED_D)        
                                          &mmv MOVE_X(MMV_FAST_SPEED_R)
    
            /* nav-m-l T L */
            &lt SYMB_LAYER TAB
            &lt BASE_OVERRIDE_LAYER SPACE
            &lt FUNCT_LAYER DEL
            /* nav-m-l T R */
            &lt FUNCT_LAYER ESC
            &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
            &lt NUM_LAYER BACKSPACE
          >;
    display-name = "nav-mouse-l";
  };

    funct {
      bindings = <
        /* funct B L */
        &kp F3
        &kp F9
        &kp F8
        &kp F7
        &tog NAV_L_LAYER
        /* funct B R */
        &tog NAV_R_LAYER
        &kp F7
        &kp F8
        &kp F9
        &kt F3

        /* funct C L */
        &mt LGUI F2
        &mt LCTRL F6
        &mt LALT F5
        &mt LSHIFT F4
        &tog NAV_MOUSE_R_LAYER
        
        /* funct C R */
        &tog NAV_MOUSE_R_LAYER
        &mt RSHFT F4
        &mt RALT F5
        &mt RCTRL F6
        &mt RGUI F2

        /* funct D L */
        &kp F1
        &kp F12
        &kp F11
        &kp F10
        &kp LS(LA(L))
        /* funct D R */
        &kp LS(LA(L))
        &kp F10
        &kp F11
        &kp F12
        &kp F1

        /* funct T L */
        &lt SYMB_LAYER TAB
        &lt BASE_OVERRIDE_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* funct T R */
        &lt FUNCT_LAYER ESC
        &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
      >;
      display-name = "funct";
    };

    num {
      bindings = <
        /* num B L */
        &kp LS(MINUS)
        &kp N9
        &kp N8
        &kp N7
        &kp PLUS
        /* num B R */
        &kp PLUS
        &kp N7
        &kp N8
        &kp N9
        &kp RS(MINUS)

        /* num C L */
        &mt LGUI N0
        &mt LCTRL N6
        &mt LALT N5
        &mt LSHFT N4
        &kp MINUS
        /* num C R */
        &kp MINUS
        &mt RSHIFT N4
        &mt RIGHT_ALT N5
        &mt RCTRL N6
        &mt RGUI N0

        /* num D L */
        &kp BACKSLASH
        &kp N3
        &kp N2
        &kp N1
        &kp EQUAL
        /* num D R */
        &kp EQUAL
        &kp N1
        &kp N2
        &kp N3
        &kp BACKSLASH

        /* num T L */
        &kp TAB
        &kp SPACE
        &kp DELETE
        /* num T R */
        &kp ESC
        &kp CAPSLOCK
        &kp BACKSPACE
      >;
      label = "num";
    };
    
    
    symb {
      bindings = <
        /* symb B L */
        &kp RS(N2)
        &kp RS(N4)
        &kp LEFT_PARENTHESIS
        &kp RIGHT_PARENTHESIS
        &kp RS(N3)
        /* symb B R */
        &kp RS(N3)
        &kp LEFT_PARENTHESIS
        &kp RIGHT_PARENTHESIS
        &kp RS(N4)
        &kp RS(N2)

        /* symb C L */
        &mt RGUI PLUS
        &mt RCTRL RS(MINUS)
        &mt RALT EQUAL
        &mt RSHFT MINUS
        &kp SLASH
        /* symb C R */
        &kp SLASH
        &mt RSHFT MINUS
        &mt RALT EQUAL
        &mt RCTRL RS(MINUS)
        &mt RGUI PLUS

        /* symb D L */
        &kp RS(N8)
        &kp RS(N7)
        &kp RS(N6)
        &kp RS(N5)
        &kp RS(N1)        
        /* symb D R */
        &kp RS(N1)
        &kp RS(N5)
        &kp RS(N6)
        &kp RS(N7)
        &kp RS(N8)

        /* symb T L */
        &kp TAB
        &kp SPACE
        &kp DELETE
        /* symb T R */
        &kp ESC
        &kp CAPSLOCK
        &kp BACKSPACE
      >;
      label = "symb";
    };
    

    layers {
      bindings = <
        /* layers B L */
        &kp C_PREV
        &kp C_PLAY_PAUSE
        &kp C_NEXT
        &kp C_VOLUME_DOWN
        &kp C_VOLUME_UP
        /* layers B R */
        &kp F14
        &kp F15
        &to BASE_LAYER
        &to BASE_LAYER
        &to BASE_LAYER

        /* layers C L */
        &to BASE_LAYER
        &to NUM_LAYER
        &to SYMB_LAYER
        &to NAV_L_LAYER
        &to FUNCT_LAYER
        /* layers C R */
        &tog BASE_MIRROR_LAYER
        &to FUNCT_LAYER
        &to NAV_R_LAYER
        &to NUM_LAYER
        &to SYMB_LAYER

        /* layers D L */
        &to BASE_LAYER
        &kp LGUI
        &kp LCTRL
        &kp LALT
        &kp LSHFT
        /* layers D R */
        &kp RSHIFT
        &kp RALT
        &kp RCTRL
        &kp RGUI
        &to BASE_LAYER

        /* layers T L */
        &tog NUM_LAYER
        &tog SYMB_LAYER
        &tog NAV_L_LAYER
        /* layers T R */
        &tog NAV_R_LAYER
        &tog NUM_LAYER
        &tog SYMB_LAYER
      >;
      label = "layers";
    };


    adj {
      bindings = <        
        /* adj B L */
        &trans
        &trans
        &trans
        &trans
        &trans
        /* adj B L */        
        &trans
        &trans
        &trans
        &trans
        &studio_unlock
        
        /* adj C L */
        &trans
        &trans
        &trans
        &trans
        &trans
                
        /* adj C R */
        &out OUT_BLE
        &kp C_VOL_DN
        &kp C_MUTE
        &kp C_VOL_UP
        &trans        
        /* adj C R */
        &to BASE_LAYER
        &trans
        &trans
        &trans
        &trans
        
        /* layers D L */
        &trans
        &out OUT_USB
        &kp C_PREV
        &kp C_PLAY_PAUSE
        &kp C_NEXT
        /* layers D R */
        &to BASE_LAYER
        &trans
        &trans
        &trans
        &trans
        
        /* adj T L */
        &trans
        &trans
        &trans
        /* adj T R */
        &trans
        &trans
        &trans
      >;
      display-name = "Adjust";
    };
    
    base-override {
      bindings = <
        /* base-o B L */
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        /* base-o B R */
        &kp Y
        &kp U
        &kp I
        &kp O
        &kp P

        /* base-o C L */
        &mt LGUI A
        &mt LCTRL S
        &mt LALT D
        &mt LSHFT F
        &lt BASE_ADD_OVERRIDE_LAYER G
        /* base-o C R */
        &lt BASE_ADD_OVERRIDE_LAYER H
        &mt RSHIFT J
        &mt RALT K
        &mt RCTRL L
        &mt RGUI SEMI

        /* base-o D L */
        &lt BASE_ADD_OVERRIDE_LAYER Z
        &kp X
        &kp C
        &kp V
        &kp B
        /* base-o D R */
        &kp N
        &kp M
        &kp COMMA
        &kp DOT
        &lt BASE_ADD_OVERRIDE_LAYER SLASH

        /* base-o T L */
        &kp TAB
        &kp SPACE
        &kp DEL
        /* base-o T R */
        &kp ESC
        &kp CAPS
        &kp BACKSPACE
      >;
      display-name = "base-override";
    };    


        base-add-ovv{
          bindings = <
            /* base-add-ovv B L */
            &trans
            &trans
            &trans
            &trans
            &kp BSLH
            /* base-add-ovv B R */
            &trans
            &trans
            &trans
            &kp GRAVE
            &trans        
    
            /* base-add-ovv C L */
            &trans
            &trans
            &trans
            &trans
            &trans
            /* base-add-ovv C R */
            &trans
            &trans
            &trans
            &kp SQT
            &trans
            
            /* base-add-ovv D L */
            &trans
            &kp MINUS
            &kp EQUAL
            &trans
            &trans
            /* base-add-ovv D R */
            &trans
            &kp LBKT
            &kp RBKT
            &kp BSLH
    
            /* base-add-ovv T L */
            &trans
            &trans
            &trans
            &trans
            /* base-add T R */
            &trans
            &trans
            &trans
            &trans
          >;
          display-name = "base-add-ovv";
        };
    
      
    };
};
