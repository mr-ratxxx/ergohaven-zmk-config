#define ZMK_POINTING_DEFAULT_SCRL_VAL 25

// Константы для перемещений

#define BASE_LAYER 0
#define BASE_MIRROR_LAYER 1
#define NAV_R_LAYER 2
#define NAV_L_LAYER 3
#define FUNCT_LAYER 4
#define NUM_LAYER 5
#define SYMB_LAYER 6
#define LAYERS_LAYER 7
#define ADJ_LAYER 8
#define BASE_OVERRIDE_LAYER 9

#define MMV_SLOW_ALT_SPEED 250
#define MMV_SLOW_ALT_SPEED_L -250
#define MMV_SLOW_ALT_SPEED_U -250
#define MMV_SLOW_ALT_SPEED_D 250
#define MMV_SLOW_ALT_SPEED_R 250

//

#define MMV_FAST_ALT_SPEED_X 950
#define MMV_FAST_ALT_SPEED_Y 950
#define MMV_FAST_ALT_SPEED_L -950
#define MMV_FAST_ALT_SPEED_U -950
#define MMV_FAST_ALT_SPEED_D 950
#define MMV_FAST_ALT_SPEED_R 950

//

#define MMV_FAST_SPEED_X 1100
#define MMV_FAST_SPEED_Y 750
#define MMV_FAST_SPEED_L -MMV_FAST_SPEED_X
#define MMV_FAST_SPEED_U -MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_D MMV_FAST_SPEED_Y
#define MMV_FAST_SPEED_R MMV_FAST_SPEED_X

//
// 1100x750, 700x480, 600x4100
#define MMV_SUPER_FAST_SPEED_X 600
#define MMV_SUPER_FAST_SPEED_Y 410
#define MMV_SUPER_FAST_SPEED_L -MMV_SUPER_FAST_SPEED_X
#define MMV_SUPER_FAST_SPEED_U -MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_D MMV_SUPER_FAST_SPEED_Y
#define MMV_SUPER_FAST_SPEED_R MMV_SUPER_FAST_SPEED_X

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>

&mt {
  tapping-term-ms = <180>;
  flavor = "balanced";
  quick-tap-ms = <110>;
};

&msc {
  time-to-max-speed-ms = <8>;
  acceleration-exponent = <5>;
};

&mmv {
  acceleration-exponent = <0>;
  time-to-max-speed-ms = <100>;
  delay-ms = <0>;
};

&lt {
  tapping-term-ms = <171>;
};

/ {
  behaviors {
    enc_vol: enc_vol {
      compatible = "zmk,behavior-sensor-rotate";
      label = "ENC_VOL";
      #sensor-binding-cells = <0>;
      bindings = <&kp C_VOL_UP>, <&kp C_VOL_DN>;
    };

    ctrl_bslh: ctrl_bslh {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_BSLH";
      #binding-cells = <0>;
      bindings = <&kp FSLH>, <&kp BACKSLASH>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    // ru-ю en/alt-ru .
    alt_ru_en_dot: alt_ru_en_dot {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_DOT";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp RS(N7)>;
      mods = <(MOD_LALT | MOD_RALT)>;
    };

    // ru-б en/alt-ru ,
    alt_ru_en_comma: alt_ru_en_comma {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_COMMA";
      #binding-cells = <0>;
      bindings = <&kp COMMA>, <&kp RS(N6)>;
      mods = <(MOD_LALT | MOD_RALT)>;
    };

    // ru-ж en/alt-ru ;
    alt_ru_en_semi: alt_ru_en_semi {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_SEMI";
      #binding-cells = <0>;
      bindings = <&mt RGUI SEMI>, <&kp RS(N8)>;
      mods = <(MOD_LALT | MOD_RALT)>;
    };

    // ru-э en/alt-ru "
    alt_ru_en_sqt: alt_ru_en_sqt {
      compatible = "zmk,behavior-mod-morph";
      label = "ALT_RU_EN_SQT";
      #binding-cells = <0>;
      bindings = <&kp SQT>, <&kp RS(N2)>;
      mods = <(MOD_LALT | MOD_RALT)>;
    };

/*
        alt_to_5: alt_to_5 {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_TO_5";
            #binding-cells = <0>;
            bindings = <&lt 5 LG(LEFT_BRACKET)>, <&to 5>;

            mods = <(MOD_LALT | MOD_RALT)>;
        };
        *\

        // bslh-\ alt-lt7
        //alt_bslh: alt_bslh {
        //            compatible = "zmk,behavior-mod-morph";
        //            label = "ALT_BSLH";
        //            #binding-cells = <0>;
        //            bindings = <&kp BSLH>, <&mo 3>;
        //            mods = <(MOD_LALT | MOD_RALT)>;
        //        };               

    ctrl_left_bracket: ctrl_left_bracket {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_LEFT_BRACKET";
      #binding-cells = <0>;
      bindings = <&kp COMMA>, <&kp LEFT_BRACKET>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    ctrl_right_bracket: ctrl_right_bracket {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_RIGHT_BRACKET";
      #binding-cells = <0>;
      bindings = <&kp DOT>, <&kp RIGHT_BRACKET>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
    };

    ctrl_p_sqt: ctrl_p_sqt {
      compatible = "zmk,behavior-mod-morph";
      label = "CTRL_P_SQT";
      #binding-cells = <0>;
      bindings = <&kp P>, <&kp SQT>;
      mods = <(MOD_LCTL | MOD_RCTL)>;
    };
/*
        alt_scrl_up: alt_scrl_up {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_SCRL_UP";
            #binding-cells = <0>;
            bindings = <&msc SCRL_UP>,
            <&msc MOVE_Y(100)>;
            mods = <(MOD_RALT)>;
        };

        alt_scrl_down: alt_scrl_down {
            compatible = "zmk,behavior-mod-morph";
            label = "ALT_SCRL_DOWN";
            #binding-cells = <0>;
            bindings = <&msc SCRL_DOWN>,
            <&msc MOVE_Y(-100)>;
             mods = <(MOD_RALT)>;
        };
        */

    ralt_y_up3: ralt_y_up3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_Y_UP3";
      #binding-cells = <0>;
      bindings = 
        <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_U)>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
      mods = <(MOD_RALT)>;
    };

    ralt_y_down3: ralt_y_down3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_Y_DOWN3";
      #binding-cells = <0>;
      bindings = 
        <&mmv MOVE_Y(MMV_SLOW_ALT_SPEED_D)>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
      mods = <(MOD_RALT)>;
    };

    ralt_x_left3: ralt_x_left3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_X_LEFT3";
      #binding-cells = <0>;
      bindings =
        <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_L)>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
      mods = <(MOD_RALT)>;
    };

    ralt_x_right3: ralt_x_right3 {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_X_RIGHT3";
      #binding-cells = <0>;
      bindings =
        <&mmv MOVE_X(MMV_SLOW_ALT_SPEED_R)>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
      mods = <(MOD_RALT)>;
    };

    /* mouse 0 layer */
    ralt_base_left: ralt_base_left {
      compatible = "zmk,behavior-mod-morph";
      label = "ralt_base_left";
      #binding-cells = <0>;
      bindings =
        <&kp M>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_L)>;
      mods = <(MOD_RALT)>;
    };

    ralt_base_up: ralt_base_up {
      compatible = "zmk,behavior-mod-morph";
      label = "RALT_BASE_UP";
      #binding-cells = <0>;
      bindings = 
        <&kp COMMA>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_U)>;
      mods = <(MOD_RALT)>;
    };

    ralt_base_down: ralt_base_down {
      compatible = "zmk,behavior-mod-morph";
      label = "ralt_base_down";
      #binding-cells = <0>;
      bindings = 
        <&kp DOT>,
        <&mmv MOVE_Y(MMV_SUPER_FAST_SPEED_D)>;
      mods = <(MOD_RALT)>;
    };

    ralt_base_right: ralt_base_right {
      compatible = "zmk,behavior-mod-morph";
      label = "ralt_base_right";
      #binding-cells = <0>;
      bindings =
        <&kp SLASH>,
        <&mmv MOVE_X(MMV_SUPER_FAST_SPEED_R)>;
      mods = <(MOD_RALT)>;
    };
    /* end mouse 0 layer */
    
    ralt_to_nav_r: ralt_to_nav_r {
          compatible = "zmk,behavior-mod-morph";
          label = "RALT_TO_NAV_R";
          #binding-cells = <0>;
          bindings =
            <&lt NAV_R_LAYER RG(RC(SPACE))>,
            <&tog NAV_R_LAYER>;
          mods = <(MOD_RALT)>;
        };
        
    alt_to_nav_l: alt_to_nav_l {
              compatible = "zmk,behavior-mod-morph";
              label = "ALT_TO_NAV_L";
              #binding-cells = <0>;
              bindings =
                <&lt NAV_L_LAYER SPACE>,
                <&tog NAV_L_LAYER>;
              mods = <(MOD_LALT)>;
            };

    layer_hold_tap: layer_hold_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "LAYER_HOLD_TAP";
      #binding-cells = <2>;
      tapping-term-ms = <180>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&tog>, <&kp>;
    };

    layer_to_tap: layer_to_tap {
      compatible = "zmk,behavior-hold-tap";
      label = "LAYER_TO_TAP";
      #binding-cells = <2>;
      tapping-term-ms = <180>;
      quick-tap-ms = <0>;
      flavor = "tap-preferred";
      bindings = <&to>, <&kp>;
    };
  };

  combos {
    compatible = "zmk,combos";

    TOGGLE_R_ALT_L {
          bindings = <&kt RALT>;          
            key-positions = <50 51>;
          layers = <BASE_LAYER BASE_MIRROR_LAYER BASE_OVERRIDE_LAYER NAV_R_LAYER NAV_L_LAYER>;
        };
        
        TOGGLE_R_ALT_R {
                  bindings = <&kt RALT>;
                   key-positions = <58 59>;
                  layers = <BASE_LAYER BASE_MIRROR_LAYER BASE_OVERRIDE_LAYER NAV_R_LAYER NAV_L_LAYER>;
                };

    FROM_LAYERS_TO_ADJ_LAYER {
      bindings = <&kp ENTER>;
      key-positions = <10 11>;
      layers = <8>;
    };

    ENTER_R_BASE {
      bindings = <&kp ENTER>;
      key-positions = <45 46>;
      layers = <BASE_LAYER FUNCT_LAYER NUM_LAYER SYMB_LAYER LAYERS_LAYER BASE_OVERRIDE_LAYER>;
    };
    
    ENTER_R_BASE2 {
          bindings = <&kp ENTER>;
          key-positions = <46 47>;
          };

    ENTER_L {
      bindings = <&kp ENTER>;
      key-positions = <38 39>;
    };

    ENTER_R_NAV {
      bindings = <&kp ENTER>;
      key-positions = <31 32>;
      layers = <NAV_L_LAYER NAV_R_LAYER>;
    };
    
    N_R {
              bindings = <&kp N0>;
              key-positions = <31 32>;
                    layers = <NUM_LAYER>;          
            };
            
            N_L {
                          bindings = <&kp N0>;
                          key-positions = <25 26>;
                                layers = <NUM_LAYER>;          
                        };

    MOUSE1_R_NAV {
      bindings = <&mkp MB1>;
      key-positions = <45 46>;
      layers = <NAV_L_LAYER NAV_R_LAYER>;
    };

    MOUSE2_R_NAV {
      bindings = <&mkp MB2>;
      key-positions = <45 46 47>;
      layers = <NAV_L_LAYER NAV_R_LAYER>;
    };

    MOUSE1_L_BASE {
      bindings = <&mkp MB1>;
      key-positions = <40 39>;
    };

    MOUSE2_L_BASE {
      bindings = <&mkp MB2>;
      key-positions = <38 39 40>;
    };

    UI_REVERT {
      bindings = <&kp RG(Z)>;
      key-positions = <20 19>;
      layers = <NAV_L_LAYER NAV_R_LAYER FUNCT_LAYER LAYERS_LAYER>;
    };

    UIO_REPEAT {
      bindings = <&kp LS(LG(Z))>;
      key-positions = <19 20 21>;
      layers = <NAV_L_LAYER NAV_R_LAYER FUNCT_LAYER LAYERS_LAYER>;
    };
    
    UI_REVERT_L {
          bindings = <&kp RG(Z)>;
          key-positions = <15 16>;
          layers = <NAV_L_LAYER NAV_R_LAYER FUNCT_LAYER LAYERS_LAYER>;
        };
    
        UIO_REPEAT_L {
          bindings = <&kp LS(LG(Z))>;
          key-positions = <14 15 16>;
          layers = <NAV_L_LAYER NAV_R_LAYER FUNCT_LAYER LAYERS_LAYER>;
        };

    SHIFT_TOGGLE {
      bindings = <&kt LSHIFT>;
      key-positions = <31 28>;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base {
      bindings = <
        /* base A L */
        &layer_to_tap BASE_LAYER ESC
        &layer_hold_tap NUM_LAYER F2
        &layer_hold_tap SYMB_LAYER F3
        &layer_hold_tap NAV_L_LAYER F4
        &layer_hold_tap FUNCT_LAYER F5
        &layer_to_tap BASE_LAYER F6
        /* base A R */
        &layer_to_tap BASE_LAYER F7
        &layer_hold_tap FUNCT_LAYER F8
        &layer_hold_tap NAV_R_LAYER F9
        &layer_hold_tap NUM_LAYER F10
        &layer_hold_tap SYMB_LAYER F11
        &layer_to_tap BASE_LAYER F12

        /* base B L */
        &kp LG(TAB)
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        /* base B R */
        &kp Y
        &kp U
        &kp I
        &kp O
        &kp P
        &kp GRAVE

        /* base C L */
        &kp CAPS
        &mt LGUI A
        &mt LCTRL S
        &mt LALT D
        &mt LSHFT F
        &kp G
        /* base C R */
        &kp H
        &mt RSHIFT J
        &mt RALT K
        &mt RCTRL L
        &mt RGUI SEMI
        &kp SQT

        /* base D L */
        &kp SPACE
        &kp Z
        &kp X
        &kp C
        &kp V
        &kp B
        &lt 7 CAPS
        /* base D R */
        &lt 7 SPACE
        &kp N
        &ralt_base_left
        &ralt_base_up
        &ralt_base_down
        &ralt_base_right
        &kp BSLH

        /* base T L */
        &lt LAYERS_LAYER MINUS
        &lt NUM_LAYER EQUAL
        &lt SYMB_LAYER TAB
        &alt_to_nav_l
        &lt FUNCT_LAYER DEL
        /* base T R */
        &lt FUNCT_LAYER ESC
        &ralt_to_nav_r
        &lt NUM_LAYER BACKSPACE
        &lt SYMB_LAYER LBKT
        &lt LAYERS_LAYER RIGHT_BRACKET
      >;
      display-name = "base";
    };

    base_mirror {
      bindings = <
        /* base-m A L */
        &layer_to_tap BASE_LAYER ESC
        &layer_hold_tap NUM_LAYER F2
        &layer_hold_tap SYMB_LAYER F3
        &layer_hold_tap NAV_L_LAYER F4
        &layer_hold_tap FUNCT_LAYER F5
        &layer_to_tap BASE_LAYER F6
        /* base-m A R */
        &layer_to_tap BASE_LAYER F7
        &layer_hold_tap FUNCT_LAYER F8
        &layer_hold_tap NAV_R_LAYER F9
        &layer_hold_tap NUM_LAYER F10
        &layer_hold_tap SYMB_LAYER F11
        &layer_to_tap BASE_LAYER F12
      
              /* base-m B L */
              &kp LG(TAB)
              &kp Q
              &kp W
              &kp E
              &kp R
              &kp T
              /* base-m B R */
              &kp Y
              &kp U
              &kp I
              &kp O
              &kp P
              &kp GRAVE
      
              /* base-m C L */
              &kp CAPS
              &mt LGUI A
              &mt LCTRL S
              &mt LALT D
              &mt LSHFT F
              &kp G
              /* base-m C R */
              &kp H
              &mt RSHIFT J
              &mt RALT K
              &mt RCTRL L
              &mt RGUI SEMI
              &kp SQT
      
              /* base-m D L */
              &kp SPACE
              &kp Z
              &kp X
              &kp C
              &kp V
              &kp B
              &lt 7 CAPS
              /* base-m D R */
              &lt 7 SPACE
              &kp N
              &ralt_base_left
              &ralt_base_up
              &ralt_base_down
              &ralt_base_right
              &kp BSLH
      
              /* base-m T L */
              &lt LAYERS_LAYER MINUS
              &lt NUM_LAYER EQUAL
              &lt SYMB_LAYER TAB
              &alt_to_nav_l
              &lt FUNCT_LAYER DEL
              /* base-m T R */
              &lt FUNCT_LAYER ESC
              &ralt_to_nav_r
              &lt NUM_LAYER BACKSPACE
              &lt SYMB_LAYER LBKT
              &lt LAYERS_LAYER RIGHT_BRACKET
            >;
      display-name = "base-mirror";
    };

    nav-r {
      bindings = <
        /* nav-r A L */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        /* nav-r A R */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans

        /* nav-r B L */
        &msc SCRL_LEFT
        &msc SCRL_UP
        &msc SCRL_DOWN
        &kp PAGE_DOWN
        &kp PAGE_UP
        &msc SCRL_RIGHT
        /* nav-r B R */
        &msc SCRL_LEFT
        &kp PG_UP
        &kp PAGE_DOWN
        &msc SCRL_DOWN
        &msc SCRL_UP
        &msc SCRL_RIGHT

        /* nav-r C L */
        &kp LG(C)
        &mt LGUI LEFT_ARROW
        &mt LCTRL UP
        &mt LALT DOWN
        &mt LSHFT RIGHT_ARROW
        &msc SCRL_UP
        /* nav-r C R */
        &msc SCRL_UP
        &kp LEFT_ARROW
        &kp UP
        &kp DOWN
        &kp RIGHT_ARROW
        &kp LG(TAB)

        /* nav-r D L */
        &kp RG(V)
        &mmv MOVE_X(MMV_FAST_SPEED_L)
        &mmv MOVE_Y(MMV_FAST_SPEED_D)
        &mmv MOVE_Y(MMV_FAST_SPEED_U)
        &mmv MOVE_X(MMV_FAST_SPEED_R)
        &msc SCRL_DOWN
        &trans
        /* nav-r D R */
        &trans
        &msc SCRL_DOWN
        &ralt_x_left3
        &ralt_y_up3
        &ralt_y_down3
        &ralt_x_right3
        &kp ENTER

        /* nav-r T L */
        &layer_to_tap LAYERS_LAYER RG(LEFT_BRACKET)
        &layer_to_tap NUM_LAYER RG(RIGHT_BRACKET)
        &lt SYMB_LAYER TAB
        &lt BASE_OVERRIDE_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* nav-r T R */
        &lt FUNCT_LAYER ESC
        &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
        &layer_to_tap SYMB_LAYER RG(LEFT_BRACKET)
        &layer_to_tap LAYERS_LAYER RG(RIGHT_BRACKET)
      >;
      display-name = "nav-r";
    };

nav-l {
  bindings = <
    /* nav-l A L */
    &trans
    &trans
    &trans
    &trans
    &trans
    &trans
    /* nav-l A R */
    &trans
    &trans
    &trans
    &trans
    &trans
    &trans

    /* nav-l B L */
    &msc SCRL_LEFT
    &msc SCRL_UP
    &msc SCRL_DOWN
    &kp PAGE_DOWN
    &kp PAGE_UP
    &msc SCRL_RIGHT
    /* nav-l B R */
    &msc SCRL_LEFT
    &kp PAGE_UP
    &kp PAGE_DOWN
    &msc SCRL_DOWN    
    &msc SCRL_UP    
    &msc SCRL_RIGHT

    /* nav-l C L */
    &kp LG(TAB)
    &kp LEFT_ARROW
    &kp DOWN
    &kp UP
    &kp RIGHT_ARROW
    &msc SCRL_UP
    /* nav-l C R */
    &msc SCRL_UP
    &mt LSHFT LEFT_ARROW
    &mt LALT DOWN
    &mt LCTRL UP
    &mt LGUI RIGHT_ARROW
    &kp RG(C)

    /* nav-l D L */
    &kp ENTER
    &ralt_x_left3
    &ralt_y_down3
    &ralt_y_up3    
    &ralt_x_right3
    &msc SCRL_DOWN
    &trans
    /* nav-l D R */
    &trans
    &msc SCRL_DOWN
    &mmv MOVE_X(MMV_FAST_SPEED_L)
    &mmv MOVE_Y(MMV_FAST_SPEED_U)
    &mmv MOVE_Y(MMV_FAST_SPEED_D)
    &mmv MOVE_X(MMV_FAST_SPEED_R)
    &kp RG(V)

    /* nav-l T L */
    &layer_to_tap LAYERS_LAYER RG(RIGHT_BRACKET)
    &layer_to_tap SYMB_LAYER RG(LEFT_BRACKET)
    &lt NUM_LAYER BACKSPACE
    &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
    &lt FUNCT_LAYER ESC
    /* nav-l T R */
    &lt FUNCT_LAYER DEL
    &lt BASE_OVERRIDE_LAYER SPACE
    &lt SYMB_LAYER TAB
    &layer_to_tap NUM_LAYER RG(RIGHT_BRACKET)
    &layer_to_tap LAYERS_LAYER RG(LEFT_BRACKET)
  >;
  display-name = "nav-l";
};

    funct {
      bindings = <
        /* funct A L */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        /* funct A R */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans

        /* funct B L */
        &msc SCRL_LEFT
        &kp F3
        &kp F9
        &kp F8
        &kp F7
        &msc SCRL_RIGHT
        /* funct B R */
        &msc SCRL_LEFT
        &kp F7
        &kp F8
        &kp F9
        &kt F3
        &msc SCRL_RIGHT

        /* funct C L */
        &kp LG(TAB)
        &mt LGUI F2
        &mt LCTRL F6
        &mt LALT F5
        &mt LSHIFT F4
        &msc SCRL_UP
        /* funct C R */
        &msc SCRL_UP
        &mt RSHFT F4
        &mt RALT F5
        &mt RCTRL F6
        &mt RGUI F2
        &kp LG(TAB)

        /* funct D L */
        &none
        &kp F1
        &kp F12
        &kp F11
        &kp F10
        &msc SCRL_DOWN
        &trans
        /* funct D R */
        &trans
        &msc SCRL_DOWN
        &kp F10
        &kp F11
        &kp F12
        &kp F1
        &none

        /* funct T L */
        &layer_to_tap LAYERS_LAYER RG(LEFT_BRACKET)
        &layer_to_tap NUM_LAYER RG(RIGHT_BRACKET)
        &lt SYMB_LAYER TAB
        &lt BASE_OVERRIDE_LAYER SPACE
        &lt FUNCT_LAYER DEL
        /* funct T R */
        &lt FUNCT_LAYER ESC
        &lt BASE_OVERRIDE_LAYER RG(RC(SPACE))
        &lt NUM_LAYER BACKSPACE
        &layer_to_tap SYMB_LAYER RG(LEFT_BRACKET)
        &layer_to_tap LAYERS_LAYER RG(RIGHT_BRACKET)
      >;
      display-name = "funct";
    };

    num {
      bindings = <
        /* num A L */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        /* num A R */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans

        /* num B L */
        &trans
        &kp LS(MINUS)
        &kp N9
        &kp N8
        &kp N7
        &kp PLUS
        /* num B R */
        &kp PLUS
        &kp N7
        &kp N8
        &kp N9
        &kp RS(MINUS)
        &kp MINUS

        /* num C L */
        &kp DOT
        &mt LGUI N0
        &mt LCTRL N6
        &mt LALT N5
        &mt LSHFT N4
        &kp MINUS
        /* num C R */
        &kp N0
        &mt RSHIFT N4
        &mt RIGHT_ALT N5
        &mt RCTRL N6
        &mt RGUI N0
        &kp DOT

        /* num D L */
        &kp SLASH
        &kp BACKSLASH
        &kp N3
        &kp N2
        &kp N1
        &kp EQUAL
        &trans
        /* num D R */
        &trans
        &kp EQUAL
        &kp N1
        &kp N2
        &kp N3
        &kp SLASH
        &kp BACKSLASH

        /* num T L */
        &trans
        &trans
        &kp TAB
        &kp SPACE
        &kp DELETE
        /* num T R */
        &kp ESC
        &kp CAPSLOCK
        &kp BACKSPACE
        &trans
        &trans
      >;
      label = "num";
    };

    symb {
      bindings = <
        /* symb row 1 L */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        /* row 1 R */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans

        /* symb B L */
        &kp SQT
        &kp RS(N2)
        &kp RS(N4)
        &kp LEFT_PARENTHESIS
        &kp RIGHT_PARENTHESIS
        &kp PLUS
        /* symb B R */
        &kp SLASH
        &kp LEFT_PARENTHESIS
        &kp RIGHT_PARENTHESIS
        &kp RS(N4)
        &kp RS(N2)
        &kp SQT

        /* symb C L */
        &kp RS(SQT)
        &mt LGUI RS(N8)
        &mt LCTRL RS(N7)
        &mt LALT RS(N6)
        &mt LSHIFT RS(N5)
        &kp MINUS
        /* symb C R */
        &kp RS(N3)
        &mt RSHFT MINUS
        &mt RALT EQUAL
        &mt RCTRL RS(MINUS)
        &mt RGUI PLUS
        &kp RS(SQT)

        /* symb D L */
        &kp SLASH
        &kp BACKSLASH
        &kp RS(N3)
        &kp RS(MINUS)
        &kp RS(N1)
        &kp EQUAL
        &trans
        /* symb D R */
        &trans
        &kp BACKSLASH
        &kp RS(N1)
        &kp RS(N5)
        &kp RS(N6)
        &kp RS(N7)
        &kp RS(N8)

        /* symb T L */
        &trans
        &trans
        &kp TAB
        &kp SPACE
        &kp DELETE
        /* symb T R */
        &kp ESC
        &kp CAPSLOCK
        &kp BACKSPACE
        &trans
        &trans
      >;
      label = "symb";
    };

    layers {
      bindings = <
        /* layers A L */
        &to 0
        &kp C_PREV
        &kp C_PLAY_PAUSE
        &kp C_NEXT
        &kp C_VOLUME_DOWN
        &kp C_VOLUME_UP
        /* layers A R */
        &kp F14
        &kp F15
        &kp F16
        &kp F17
        &kp F18
        &to 0

        /* layers B L */
        &to 0
        &to NUM_LAYER F2
                &to SYMB_LAYER
                &to NAV_L_LAYER
                &to FUNCT_LAYER
        &kp ESCAPE
        /* layers B R */
        &kp TAB
        &to FUNCT_LAYER
                &to NAV_R_LAYER
                &to NUM_LAYER
                &to SYMB_LAYER
        &to 0

        /* layers C L */
        &to BASE_LAYER
        &to NUM_LAYER
        &to SYMB_LAYER
        &to NAV_L_LAYER
        &to FUNCT_LAYER
        &kp CAPSLOCK
        /* layers C R */
        &kp SPACE
        &to FUNCT_LAYER
        &to NAV_R_LAYER
        &to NUM_LAYER
        &to SYMB_LAYER
        &to BASE_LAYER

        /* layers D L */
        &to 0
        &kp LGUI
        &kp LCTRL
        &kp LALT
        &kp LSHFT
        &kp DELETE
        &trans
        /* layers D R */
        &trans
        &kp DELETE
        &kp RSHIFT
        &kp RALT
        &kp RCTRL
        &kp RGUI
        &to 0

        /* layers T L 
        &tog BASE_MIRROR_LAYER
        &tog NUM_LAYER
        &tog SYMB_LAYER
        &tog NAV_L_LAYER
        &tog FUNCT_LAYER
        /* layers T R */
        &tog FUNCT_LAYER
        &tog NAV_R_LAYER
        &tog NUM_LAYER
        &tog SYMB_LAYER
        &tog BASE_MIRROR_LAYER
      >;
      label = "layers";
    };

    adj {
      bindings = <
      
        /* adj A L */
        &bootloader
        &trans
        &trans
        &trans
        &trans
        &to 0
        /* adj A R */
        &bt BT_SEL 0
        &bt BT_SEL 1
        &bt BT_SEL 2
        &bt BT_SEL 3
        &bt BT_SEL 4
        &bt BT_CLR_ALL
        
        /* adj B L */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        /* adj B L */        
        &trans
        &trans
        &trans
        &trans
        &trans
        &studio_unlock
        
        /* adj C L */
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        
        /* adj C R */
        &out OUT_BLE
        &kp C_VOL_DN
        &kp C_MUTE
        &kp C_VOL_UP
        &trans
        &trans
        /* adj C R */
        &to 0
        &trans
        &trans
        &trans
        &trans
        &trans
        
        /* layers D L */
        &trans
        &trans
        &out OUT_USB
        &kp C_PREV
        &kp C_PLAY_PAUSE
        &kp C_NEXT
        &trans
        /* layers D R */
        &to 0
        &trans
        &trans
        &trans
        &trans
        &trans
        &trans
        
        /* adj T L */
        &trans
        &trans
        &trans
        &trans
        &trans
        /* adj T R */
        &trans
        &trans
        &trans
        &trans
        &trans
      >;
      display-name = "Adjust";
    };

    base-override {
      bindings = <
        /* base-o A L */
                &layer_to_tap BASE_LAYER ESC
                &layer_hold_tap NUM_LAYER F2
                &layer_hold_tap SYMB_LAYER F3
                &layer_hold_tap NAV_L_LAYER F4
                &layer_hold_tap FUNCT_LAYER F5
                &layer_to_tap BASE_LAYER F6
                /* base-o A R */
                &layer_to_tap BASE_LAYER F7
                &layer_hold_tap FUNCT_LAYER F8
                &layer_hold_tap NAV_R_LAYER F9
                &layer_hold_tap NUM_LAYER F10
                &layer_hold_tap SYMB_LAYER F11
                &layer_to_tap BASE_LAYER F12

        /* base-o B L */
        &kp LG(TAB)
        &kp Q
        &kp W
        &kp E
        &kp R
        &kp T
        /* base-o B R */
        &kp Y
        &kp U
        &kp I
        &kp O
        &kp P
        &kp GRAVE

        /* base-o C L */
        &kp CAPS
        &mt LGUI A
        &mt LCTRL S
        &mt LALT D
        &mt LSHFT F
        &kp G
        /* base-o C R */
        &kp H
        &mt RSHIFT J
        &mt RALT K
        &mt RCTRL L
        &mt RGUI SEMI
        &kp SQT

        /* base-o D L */
        &kp SPACE
        &kp Z
        &kp X
        &kp C
        &kp V
        &kp B
        &lt 7 CAPS
        /* base-o D R */
        &lt 7 SPACE
        &kp N
        &ralt_base_left
        &ralt_base_up
        &ralt_base_down
        &ralt_base_right
        &kp BSLH

        /* base-o T L */
        &kp MINUS
        &kp EQUAL
        &kp TAB
        &kp SPACE
        &kp DEL
        /* base-o T R */
        &kp ESC
        &kp CAPS
        &kp BACKSPACE
        &kp LBKT
        &kp RIGHT_BRACKET
      >;
      display-name = "base-override";
    };
  };
};